<Window x:Class="FingerprintLockManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实训柜指纹权限管理系统"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主体区域 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- 左侧导航栏 -->
                <ColumnDefinition Width="200"/>
                <!-- 右侧内容区 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 系统标题 -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Height="60">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="权限管理系统" Foreground="White" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 导航按钮 -->
                    <StackPanel Grid.Row="1" Margin="0,10">
                        <Button x:Name="NavUserManage" Content="👤  用户管理" Style="{StaticResource NavButton}"
                                Tag="Active" Click="NavUserManage_Click"/>
                        <Button x:Name="NavPermission" Content="🔑  权限管理" Style="{StaticResource NavButton}"
                                Click="NavPermission_Click"/>
                        <Button x:Name="NavRolePermission" Content="🛡  角色权限" Style="{StaticResource NavButton}"
                                Click="NavRolePermission_Click"/>
                        <Button x:Name="NavDevice" Content="📡  设备管理" Style="{StaticResource NavButton}"
                                Click="NavDevice_Click"/>
                        <Button x:Name="NavLog" Content="📋  日志查看" Style="{StaticResource NavButton}"
                                Click="NavLog_Click"/>
                        <Button x:Name="NavDeviceConfig" Content="⚙  设备配置(AP模式)" Style="{StaticResource NavButton}"
                                Click="NavDeviceConfig_Click"/>
                    </StackPanel>

                    <!-- 底部用户信息 -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="CurrentUserName" Text="管理员" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" FontSize="13"/>
                            <TextBlock x:Name="CurrentUserRole" Text="admin"
                                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧内容区域：Frame 切换页面 -->
            <Frame x:Name="ContentFrame" Grid.Column="1"
                   NavigationUIVisibility="Hidden"
                   Background="{StaticResource BackgroundBrush}"
                   JournalOwnership="OwnsJournal"/>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mesh 链路状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="MeshStatusDot" Width="10" Height="10" Fill="{StaticResource DangerBrush}"/>
                    <TextBlock x:Name="MeshStatusText" Text="Mesh链路：未连接" Margin="8,0,0,0"
                               Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 在线设备数量 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="在线设备：" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="OnlineDeviceCount" Text="0" Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 传输类型 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="传输：" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TransportTypeText" Text="USB串口" Foreground="{StaticResource SubTextBrush}"
                               FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 占位 -->
                <TextBlock Grid.Column="3"/>

                <!-- 当前时间 -->
                <TextBlock x:Name="CurrentTimeText" Grid.Column="4" Foreground="{StaticResource SubTextBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
