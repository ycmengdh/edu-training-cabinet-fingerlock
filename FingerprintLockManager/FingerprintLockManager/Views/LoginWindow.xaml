<Window x:Class="FingerprintLockManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - 实训柜指纹权限管理系统"
        Height="420" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题区 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Height="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="实训柜指纹权限管理系统" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Fingerprint Lock Manager" Foreground="#CCFFFFFF" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 登录表单区 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,-30,24,24" VerticalAlignment="Top">
            <StackPanel Margin="10,20,10,10">
                <!-- 用户ID -->
                <TextBlock Text="用户ID" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <TextBox x:Name="UserIdBox" Text="admin"/>

                <!-- 密码 -->
                <TextBlock Text="密码" Style="{StaticResource LabelText}" Margin="0,16,0,6"/>
                <PasswordBox x:Name="PasswordBox" Password="admin123"/>

                <!-- 登录按钮 -->
                <Button x:Name="LoginButton" Content="登 录" Height="38" Margin="0,24,0,0"
                        Click="LoginButton_Click"/>

                <!-- 提示信息 -->
                <TextBlock x:Name="HintText" Text="默认管理员：admin / admin123"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
