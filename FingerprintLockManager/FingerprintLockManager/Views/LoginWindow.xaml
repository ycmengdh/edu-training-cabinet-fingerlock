<Window x:Class="FingerprintLockManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - 实训柜指纹权限管理系统"
        Height="460" Width="760" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="4" Background="#2B8B77" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="实训柜" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,22,0,0"/>
                    <TextBlock Text="指纹权限管理系统" Foreground="#C8D1D4" FontSize="16" Margin="0,5,0,0"/>
                    <Rectangle Width="42" Height="3" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="0,22,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LinkStatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LinkStatusText" Text="等待根节点" Foreground="White" FontSize="12"
                                   FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="LinkStatusDetailText" Text="物理链路尚未连接" Foreground="#9EAAAE"
                               FontSize="10" Margin="16,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="64,52">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="系统登录" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="ROOT ACCOUNT" Foreground="{StaticResource SubTextBrush}" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="用户 ID" Style="{StaticResource LabelText}" Margin="0,0,0,7"/>
                <TextBox x:Name="UserIdBox" Height="38"/>
                <TextBlock Text="密码" Style="{StaticResource LabelText}" Margin="0,18,0,7"/>
                <PasswordBox x:Name="PasswordBox" Height="38"/>
                <Button x:Name="LoginButton" Content="登录" Height="38" Margin="0,24,0,0" Click="LoginButton_Click"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ConnectionSettingsButton" Content="连接设置" Height="38"
                            Style="{StaticResource SecondaryButton}" Click="ConnectionSettingsButton_Click"/>
                    <Button x:Name="CommunicationTestButton" Grid.Column="2" Content="通讯测试" Height="38"
                            Style="{StaticResource SecondaryButton}" Click="CommunicationTestButton_Click"/>
                </Grid>
            </StackPanel>

            <Border x:Name="HintBorder" Grid.Row="2" Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                <TextBlock x:Name="HintText" Text="请输入账号信息"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
