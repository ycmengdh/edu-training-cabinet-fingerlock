<Page x:Class="FingerprintLockManager.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="柜子节点" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="柜子节点" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ResyncButton" Style="{StaticResource SecondaryButton}" Click="ResyncButton_Click"
                        Content="重新同步权限" Margin="0,0,8,0"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" ToolTip="刷新设备" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="远程开锁" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <ComboBox x:Name="LockSelectBox" Grid.Column="1">
                    <ComboBoxItem Content="Lock 0  系统锁" Tag="0"/>
                    <ComboBoxItem Content="Lock 1  实训柜 1" Tag="1"/>
                    <ComboBoxItem Content="Lock 2  实训柜 2" Tag="2"/>
                    <ComboBoxItem Content="Lock 3  实训柜 3" Tag="3"/>
                </ComboBox>
                <Button x:Name="RemoteUnlockButton" Grid.Column="2" Margin="10,0,0,0" Click="RemoteUnlockButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="执行开锁" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid x:Name="DeviceDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="状态" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="离线"/>
                                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Text" Value="在线"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="120"/>
                    <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="110"/>
                    <DataGridTextColumn Header="权限同步" Binding="{Binding PermissionSyncText}" Width="80"/>
                    <DataGridTextColumn Header="权限版本" Binding="{Binding Status.PermissionVersion}" Width="80"/>
                    <DataGridTextColumn Header="待传日志" Binding="{Binding Status.PendingLogCount}" Width="70"/>
                    <DataGridTextColumn Header="指纹数" Binding="{Binding Status.FingerprintCount}" Width="64"/>
                    <DataGridTextColumn Header="时间同步" Binding="{Binding TimeSyncedText}" Width="70"/>
                    <DataGridTextColumn Header="固件" Binding="{Binding FirmwareVersion}" Width="80"/>
                    <DataGridTextColumn Header="Mesh 层" Binding="{Binding Status.MeshLayer}" Width="64"/>
                    <DataGridTextColumn Header="运行时长" Binding="{Binding Status.UptimeText}" Width="90"/>
                    <DataGridTextColumn Header="最后在线" Binding="{Binding LastSeenTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
