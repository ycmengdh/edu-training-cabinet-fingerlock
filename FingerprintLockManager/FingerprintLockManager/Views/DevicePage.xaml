<Page x:Class="FingerprintLockManager.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="柜子详情" Background="{StaticResource BackgroundBrush}">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                    ToolTip="返回柜子管理" Margin="0,0,12,0" Click="BackButton_Click"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="CabinetNameText" Text="柜子详情" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="正在读取柜子状态" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ResyncButton" Style="{StaticResource SecondaryButton}"
                        Content="同步柜机数据" ToolTip="校验并补写用户指纹，同时同步当前柜权限"
                        Margin="0,0,8,0" Click="ResyncButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" ToolTip="刷新柜子详情" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Padding="0" Margin="0,0,0,14">
            <Grid Height="74">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="0.95*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding OnlineStatusText}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="连接状态" Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="38" Background="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeviceId}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="柜子 ID" Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="3" Width="1" Height="38" Background="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="FingerprintCountText" Text="{Binding Status.FingerprintCount}"
                               FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="指纹模板" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <Border Grid.Column="5" Width="1" Height="38" Background="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PermissionCountText" Text="{Binding Status.PermissionCount}"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="柜机权限记录" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <Border Grid.Column="7" Width="1" Height="38" Background="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PermissionSyncStateText" Text="{Binding PermissionSyncText}"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PermissionSyncText}" Value="已同步">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PermissionSyncText}" Value="落后">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="权限同步" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <Border Grid.Column="9" Width="1" Height="38" Background="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastSeenTime, StringFormat={}{0:MM-dd HH:mm:ss}}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="最后在线" Style="{StaticResource LabelText}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="柜子操作" Style="{StaticResource SectionTitleText}" Margin="2,0,0,10"/>
                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="柜门" Style="{StaticResource LabelText}" Margin="2,0,7,0"/>
                    <ComboBox x:Name="LockSelectBox" Width="154" Height="36" Margin="0,0,8,0">
                        <ComboBoxItem Content="系统锁（Lock 0）" Tag="0"/>
                        <ComboBoxItem Content="实训柜门 1" Tag="1"/>
                        <ComboBoxItem Content="实训柜门 2" Tag="2"/>
                        <ComboBoxItem Content="实训柜门 3" Tag="3"/>
                    </ComboBox>
                    <Button x:Name="RemoteUnlockButton" Margin="0,0,8,0" Click="RemoteUnlockButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE785;" FontFamily="{StaticResource AppIconFont}"
                                       Foreground="{StaticResource PrimaryForegroundBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="执行开锁" Foreground="{StaticResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReadStatusButton" Style="{StaticResource SecondaryButton}"
                            Content="读取状态" Margin="0,0,8,0" Click="ReadStatusButton_Click"/>
                    <Border Width="1" Height="26" Background="{StaticResource BorderBrush}" Margin="4,5,12,5"/>
                    <Button x:Name="EnrollFingerprintButton" Style="{StaticResource SecondaryButton}"
                            Content="录入用户指纹" Margin="0,0,8,0" Click="EnrollFingerprintButton_Click"/>
                    <Button x:Name="EnrollBackupFpButton" Style="{StaticResource SecondaryButton}"
                            Content="录入本机副指纹" Margin="0,0,8,0"
                            ToolTip="仅本柜生效，不占其他柜槽位；每人每柜主指纹仍只一枚"
                            Click="EnrollBackupFpButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="0">
            <TabControl BorderThickness="0" Background="Transparent" Padding="0">
                <TabItem Header="授权用户（主指纹）">
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="每用户一枚主指纹" Style="{StaticResource SectionTitleText}"/>
                                    <TextBlock x:Name="VisibleFingerprintCountText" Text="0 人" Margin="10,1,0,0"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="FpListStatusText" Text="正在读取绑定用户"
                                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="搜索" Style="{StaticResource LabelText}" Margin="0,0,7,0"/>
                                <TextBox x:Name="FingerprintSearchBox" Width="160" Height="34"
                                         ToolTip="按姓名、用户 ID 或指纹 ID 搜索"
                                         TextChanged="FingerprintFilter_Changed"/>
                                <Button x:Name="RefreshFpListButton" Style="{StaticResource IconButton}"
                                        Content="&#xE72C;" ToolTip="刷新" Margin="8,0,0,0"
                                        Click="RefreshFpListButton_Click"/>
                                <Button x:Name="DeleteSelectedFpButton" Style="{StaticResource DangerButton}"
                                        Content="删除主指纹" Margin="8,0,0,0" IsEnabled="False"
                                        Click="DeleteSelectedFpButton_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="DeviceFpListGrid" BorderThickness="0" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="DeviceFpListGrid_SelectionChanged"
                                      EnableRowVirtualization="True">
                                <DataGrid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="指纹 ID" Binding="{Binding FingerprintId}" Width="78"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="用户 ID" Binding="{Binding UserId}" Width="1.1*" MinWidth="100"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="姓名" Binding="{Binding UserName}" Width="1*" MinWidth="90"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="72"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="绑定" Binding="{Binding BindingStatusText}" Width="72"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="系统锁" Binding="{Binding Lock0Text}" Width="64"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="门1" Binding="{Binding Lock1Text}" Width="52"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="门2" Binding="{Binding Lock2Text}" Width="52"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="门3" Binding="{Binding Lock3Text}" Width="52"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="权限" Binding="{Binding PermissionSummaryText}" Width="80"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="FingerprintEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Text="&#xE928;" FontFamily="{StaticResource AppIconFont}" FontSize="28"
                                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FingerprintEmptyText" Text="当前柜子暂无绑定用户" Margin="0,8,0,0"
                                           Foreground="{StaticResource SubTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="本机副指纹">
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="仅本柜生效的备用指纹" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock x:Name="BackupListStatusText"
                                           Text="不覆盖其他柜主指纹；用于本机识别不灵敏时"
                                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="RefreshBackupListButton" Style="{StaticResource SecondaryButton}"
                                        Content="刷新清单" Click="RefreshBackupListButton_Click"/>
                                <Button x:Name="DeleteBackupFpButton" Style="{StaticResource DangerButton}"
                                        Content="删除选中" Margin="8,0,0,0" IsEnabled="False"
                                        Click="DeleteBackupFpButton_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="BackupFpListGrid" BorderThickness="0" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="BackupFpListGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="用户" Binding="{Binding UserId}" Width="1.1*"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="姓名" Binding="{Binding UserName}" Width="1*"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="本机槽位" Binding="{Binding LocalFpId}" Width="90"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="1.4*"
                                                        ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="BackupEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource AppIconFont}" FontSize="28"
                                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="BackupEmptyText" Text="本柜暂无副指纹" Margin="0,8,0,0"
                                           Foreground="{StaticResource SubTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>

