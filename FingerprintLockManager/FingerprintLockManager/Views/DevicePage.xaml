<Page x:Class="FingerprintLockManager.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="设备管理"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="设备管理" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="远程开锁：" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>
                <ComboBox x:Name="LockSelectBox" Width="120">
                    <ComboBoxItem Content="Lock0 - 系统锁" Tag="0"/>
                    <ComboBoxItem Content="Lock1 - 实训柜1" Tag="1"/>
                    <ComboBoxItem Content="Lock2 - 实训柜2" Tag="2"/>
                    <ComboBoxItem Content="Lock3 - 实训柜3" Tag="3"/>
                </ComboBox>
                <Button Content="远程开锁" Margin="12,0,0,0" Click="RemoteUnlockButton_Click"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 设备列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="DeviceDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- 状态指示圆点 -->
                    <DataGridTemplateColumn Header="状态" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="12" Height="12"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="设备ID" Binding="{Binding DeviceId}" Width="140"/>
                    <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="140"/>
                    <DataGridTextColumn Header="IP地址" Binding="{Binding IpAddress}" Width="140"/>
                    <DataGridTextColumn Header="在线状态" Binding="{Binding IsOnline}" Width="100"/>
                    <DataGridTextColumn Header="最后在线时间" Binding="{Binding LastOnlineTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
