<Page x:Class="FingerprintLockManager.RolePermissionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="角色权限" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="角色权限" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        ToolTip="重新加载" Click="ReloadButton_Click"/>
                <Button x:Name="SaveButton" Margin="8,0,0,0" Content="保存并广播" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="58"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="5" Background="#EEF1EF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"/>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="角色" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}" Margin="16,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Lock 0  系统锁" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Lock 1  实训柜 1" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Lock 2  实训柜 2" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Lock 3  实训柜 3" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>

                <Border Grid.Row="1" Grid.ColumnSpan="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="管理员  admin" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="AdminLock0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="2" x:Name="AdminLock1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="3" x:Name="AdminLock2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="4" x:Name="AdminLock3" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <Border Grid.Row="2" Grid.ColumnSpan="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="老师  teacher" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="TeacherLock0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="2" x:Name="TeacherLock1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="3" x:Name="TeacherLock2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="2" Grid.Column="4" x:Name="TeacherLock3" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="学生  student" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="StudentLock0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="2" x:Name="StudentLock1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="3" x:Name="StudentLock2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="4" x:Name="StudentLock3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
