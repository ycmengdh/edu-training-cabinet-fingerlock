<Page x:Class="FingerprintLockManager.RolePermissionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="角色权限"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="角色默认权限配置" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="（仅管理员可访问）角色默认权限作为双层权限模型的第一层，保存后将批量重新计算所有用户最终权限并同步到设备。"
                   Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,28,0,12"/>

        <!-- 权限矩阵 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" Grid.Column="0" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Background="#F0F3F7">
                    <TextBlock Text="角色" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Background="#F0F3F7">
                    <TextBlock Text="Lock0 系统锁" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Background="#F0F3F7">
                    <TextBlock Text="Lock1 实训柜1" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Background="#F0F3F7">
                    <TextBlock Text="Lock2 实训柜2" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="4" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#F0F3F7">
                    <TextBlock Text="Lock3 实训柜3" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>

                <!-- admin 行 -->
                <Border Grid.Row="1" Grid.Column="0" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                    <TextBlock Text="admin 管理员" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                    <CheckBox x:Name="AdminLock0" VerticalContentAlignment="Center"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                    <CheckBox x:Name="AdminLock1" VerticalContentAlignment="Center"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                    <CheckBox x:Name="AdminLock2" VerticalContentAlignment="Center"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="4" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <CheckBox x:Name="AdminLock3" VerticalContentAlignment="Center"/>
                </Border>

                <!-- teacher 行 -->
                <Border Grid.Row="2" Grid.Column="0" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                    <TextBlock Text="teacher 老师" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                    <CheckBox x:Name="TeacherLock0" VerticalContentAlignment="Center"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                    <CheckBox x:Name="TeacherLock1" VerticalContentAlignment="Center"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1">
                    <CheckBox x:Name="TeacherLock2" VerticalContentAlignment="Center"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="4" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <CheckBox x:Name="TeacherLock3" VerticalContentAlignment="Center"/>
                </Border>

                <!-- student 行 -->
                <Border Grid.Row="3" Grid.Column="0" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <TextBlock Text="student 学生" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <CheckBox x:Name="StudentLock0" VerticalContentAlignment="Center"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="2" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <CheckBox x:Name="StudentLock1" VerticalContentAlignment="Center"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="3" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <CheckBox x:Name="StudentLock2" VerticalContentAlignment="Center"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="4" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,0">
                    <CheckBox x:Name="StudentLock3" VerticalContentAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 占位 -->
        <TextBlock Grid.Row="2"/>

        <!-- 底部操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="保存并同步到设备" Click="SaveButton_Click"/>
            <Button x:Name="ReloadButton" Content="重新加载" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                    Click="ReloadButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
