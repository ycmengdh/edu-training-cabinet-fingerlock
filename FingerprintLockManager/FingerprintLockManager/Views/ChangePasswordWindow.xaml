<local:BorderlessWindow x:Class="FingerprintLockManager.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FingerprintLockManager"
        Title="修改密码" Icon="pack://application:,,,/Resources/logo.ico"
        Height="500" Width="480" MinHeight="480" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="修改登录密码" Style="{StaticResource TitleText}"/>
            <TextBlock Text="密码使用 PBKDF2 加密保存，并随业务数据安全同步"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,5,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,18,0,18" Padding="20,18"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="当前密码" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="OldPasswordBox"/>
                <TextBlock Text="新密码" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                <PasswordBox x:Name="NewPasswordBox"/>
                <TextBlock Text="确认新密码" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox"/>
                <TextBlock x:Name="HintText" Text="密码至少需要 8 个字符"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,12,0,0"
                           MinHeight="30" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Height="38" Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="更新密码" Height="38" Margin="8,0,0,0"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
