<Window x:Class="FingerprintLockManager.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改密码" Height="390" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="修改登录密码" Style="{StaticResource TitleText}"/>
            <TextBlock Text="密码将保存在根节点，并使用 PBKDF2 加密保护"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,18,0,14" Padding="18,16">
            <StackPanel>
                <TextBlock Text="当前密码" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="OldPasswordBox"/>
                <TextBlock Text="新密码" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                <PasswordBox x:Name="NewPasswordBox"/>
                <TextBlock Text="确认新密码" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox"/>
                <TextBlock x:Name="HintText" Text="密码至少需要 8 个字符"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="更新密码" Margin="8,0,0,0" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
