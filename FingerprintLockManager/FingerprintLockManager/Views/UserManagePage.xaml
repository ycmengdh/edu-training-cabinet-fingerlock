<Page x:Class="FingerprintLockManager.UserManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="用户管理" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageTitleText" Text="用户管理" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <ScrollViewer Grid.Column="1" Style="{StaticResource ToolbarScroll}" VerticalAlignment="Bottom" MaxWidth="720">
              <StackPanel Orientation="Horizontal">
                <!-- 账号维护 -->
                <Button x:Name="AddUserButton" Click="AddUserButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource AppIconFont}" Foreground="{StaticResource PrimaryForegroundBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="添加用户" Foreground="{StaticResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="EditUserButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="编辑" Click="EditUserButton_Click"/>
                <Button x:Name="ResetPasswordButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="重置密码" Click="ResetPasswordButton_Click"/>
                <Button x:Name="ToggleUserButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="启用 / 停用" Click="ToggleUserButton_Click"/>
                <Button x:Name="DeleteUserButton" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteUserButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="删除" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,6,2,6"/>
                <!-- 场景入口 -->
                <Button x:Name="AssignFingerprintButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        ToolTip="打开指纹录入流程" Click="AssignFingerprintButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE928;" FontFamily="{StaticResource AppIconFont}" Margin="0,0,8,0"/>
                        <TextBlock Text="录入指纹"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RestoreFingerprintButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="恢复到柜子" ToolTip="从根节点模板恢复到指定柜子"
                        Click="RestoreFingerprintButton_Click"/>
                <Button x:Name="BatchAssignPermButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="批量分配权限" ToolTip="为多选用户分配柜子锁权限并同步"
                        Click="BatchAssignPermButton_Click"/>
                <Button x:Name="ImportCsvButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="导入 CSV" ToolTip="批量导入用户" Click="ImportCsvButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新用户"
                        Margin="8,0,0,0" Click="RefreshButton_Click"/>
              </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="RoleFilterPanel" Orientation="Horizontal">
                    <TextBlock Text="角色" Style="{StaticResource LabelText}" Margin="0,0,10,0"/>
                    <ComboBox x:Name="RoleFilterBox" Width="140" SelectionChanged="RoleFilterBox_SelectionChanged">
                        <ComboBoxItem Content="全部角色" Tag=""/>
                        <ComboBoxItem Content="管理员" Tag="admin"/>
                        <ComboBoxItem Content="老师" Tag="teacher"/>
                        <ComboBoxItem Content="学生" Tag="student"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="搜索" Style="{StaticResource LabelText}" Margin="16,0,8,0"/>
                <TextBox x:Name="UserSearchBox" Width="200" Height="34"
                         ToolTip="姓名 / 用户 ID / 班级" TextChanged="UserSearchBox_TextChanged"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid x:Name="UserDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Extended"
                      EnableRowVirtualization="True">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户 ID" Binding="{Binding UserId}" Width="170"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="140"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="90"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="班级" Binding="{Binding ClassId}" Width="110"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="72"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="指纹 ID" Binding="{Binding FingerprintId}" Width="100"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="*"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Style="{StaticResource PagerBar}">
            <Button x:Name="PrevPageButton" Style="{StaticResource SecondaryButton}" Content="上一页" Width="80"
                    Click="PrevPageButton_Click"/>
            <TextBlock x:Name="PageInfoText" Style="{StaticResource PagerInfoText}" Text="第 1 / 1 页"/>
            <Button x:Name="NextPageButton" Style="{StaticResource SecondaryButton}" Content="下一页" Width="80"
                    Click="NextPageButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
