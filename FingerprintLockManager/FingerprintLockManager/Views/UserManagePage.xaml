<Page x:Class="FingerprintLockManager.UserManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="用户管理"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="用户管理" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>

        <!-- 工具栏：筛选 + 操作按钮 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="角色筛选：" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>
                <ComboBox x:Name="RoleFilterBox" Width="120" SelectionChanged="RoleFilterBox_SelectionChanged">
                    <ComboBoxItem Content="全部" Tag=""/>
                    <ComboBoxItem Content="管理员" Tag="admin"/>
                    <ComboBoxItem Content="老师" Tag="teacher"/>
                    <ComboBoxItem Content="学生" Tag="student"/>
                </ComboBox>

                <TextBlock Text="班级筛选：" Style="{StaticResource LabelText}" Margin="24,0,8,0"/>
                <ComboBox x:Name="ClassFilterBox" Width="180" SelectionChanged="ClassFilterBox_SelectionChanged"/>

                <Button Content="+ 添加用户" Margin="24,0,0,0" Click="AddUserButton_Click"/>
                <Button Content="删除用户" Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                        Click="DeleteUserButton_Click"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 用户列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="UserDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户ID" Binding="{Binding UserId}" Width="160"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="80"/>
                    <DataGridTextColumn Header="所属班级" Binding="{Binding ClassId}" Width="160"/>
                    <DataGridTextColumn Header="指纹ID" Binding="{Binding FingerprintId}" Width="100"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
