<Page x:Class="FingerprintLockManager.UserManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="用户管理" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="用户管理" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="AddUserButton" Click="AddUserButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="添加用户" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ImportCsvButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="导入 CSV" Click="ImportCsvButton_Click"/>
                <Button x:Name="AssignFingerprintButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="AssignFingerprintButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE928;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                        <TextBlock Text="录入指纹"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RestoreFingerprintButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="恢复到柜子" Click="RestoreFingerprintButton_Click"/>
                <Button x:Name="EditUserButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="编辑" Click="EditUserButton_Click"/>
                <Button x:Name="ResetPasswordButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="重置密码" Click="ResetPasswordButton_Click"/>
                <Button x:Name="ToggleUserButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="启用 / 停用" Click="ToggleUserButton_Click"/>
                <Button x:Name="DeleteUserButton" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteUserButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="删除" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新用户"
                        Margin="8,0,0,0" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="角色" Style="{StaticResource LabelText}" Margin="0,0,10,0"/>
                <ComboBox x:Name="RoleFilterBox" Width="140" SelectionChanged="RoleFilterBox_SelectionChanged">
                    <ComboBoxItem Content="全部角色" Tag=""/>
                    <ComboBoxItem Content="管理员" Tag="admin"/>
                    <ComboBoxItem Content="老师" Tag="teacher"/>
                    <ComboBoxItem Content="学生" Tag="student"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid x:Name="UserDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户 ID" Binding="{Binding UserId}" Width="170"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="140"/>
                    <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="90"/>
                    <DataGridTextColumn Header="班级" Binding="{Binding ClassId}" Width="110"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="72"/>
                    <DataGridTextColumn Header="指纹 ID" Binding="{Binding FingerprintId}" Width="100"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
