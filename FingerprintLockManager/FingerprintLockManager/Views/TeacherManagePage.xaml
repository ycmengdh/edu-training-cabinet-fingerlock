<Page x:Class="FingerprintLockManager.TeacherManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="老师管理" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="老师管理" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="管理老师账号及负责班级" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="FingerprintSyncButton" Style="{StaticResource SecondaryButton}"
                        Content="老师指纹同步" Margin="0,0,8,0" Click="FingerprintSyncButton_Click"/>
                <Button x:Name="EnrollTeacherFingerprintButton" Style="{StaticResource SecondaryButton}"
                        Content="录入老师指纹" Margin="0,0,8,0" Click="EnrollTeacherFingerprintButton_Click"/>
                <Button x:Name="AddTeacherButton" Content="添加老师" Click="AddTeacherButton_Click"/>
                <Button x:Name="EditTeacherButton" Style="{StaticResource SecondaryButton}" Content="编辑" Margin="8,0,0,0" Click="EditTeacherButton_Click"/>
                <Button x:Name="ResetPasswordButton" Style="{StaticResource SecondaryButton}" Content="重置密码" Margin="8,0,0,0" Click="ResetPasswordButton_Click"/>
                <Button x:Name="ToggleTeacherButton" Style="{StaticResource SecondaryButton}" Content="启用 / 停用" Margin="8,0,0,0" Click="ToggleTeacherButton_Click"/>
                <Button x:Name="DeleteTeacherButton" Style="{StaticResource DangerButton}" Content="删除" Margin="8,0,0,0" Click="DeleteTeacherButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新老师" Margin="8,0,0,0" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <DataGrid x:Name="TeacherDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="老师 ID" Binding="{Binding UserId}" Width="180"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="160"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="负责班级" Binding="{Binding ClassId}" Width="180"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="指纹 ID" Binding="{Binding FingerprintId}" Width="100"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="180"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Style="{StaticResource PagerBar}">
            <Button x:Name="PrevPageButton" Style="{StaticResource SecondaryButton}" Content="上一页" Width="80"
                    Click="PrevPageButton_Click"/>
            <TextBlock x:Name="PageInfoText" Style="{StaticResource PagerInfoText}" Text="第 1 / 1 页"/>
            <Button x:Name="NextPageButton" Style="{StaticResource SecondaryButton}" Content="下一页" Width="80"
                    Click="NextPageButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
