<Page x:Class="FingerprintLockManager.DeviceCapacityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="设备容量监控"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="设备容量监控" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="ESP32-S3 N16R8 Flash 最多存 200 个用户指纹。达到 190 自动预警。可按班级删除归还空间。"
                   Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,28,0,12"/>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="查询所有柜子容量" Click="QueryAllButton_Click"/>
                <Button Content="按班级清理" Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                        Click="ClearByClassButton_Click"/>
                <Button Content="刷新列表" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 柜子容量列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="CapacityDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="柜子ID" Binding="{Binding DeviceId}" Width="140"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding DeviceName}" Width="140"/>
                    <DataGridTextColumn Header="在线状态" Binding="{Binding OnlineText}" Width="100"/>
                    <DataGridTextColumn Header="已用/上限" Binding="{Binding UsageText}" Width="120"/>
                    <DataGridTextColumn Header="利用率" Binding="{Binding UsagePercent, StringFormat={}{0}%}" Width="100"/>
                    <DataGridTextColumn Header="级别" Binding="{Binding LevelText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 预警提示横幅 -->
        <Border x:Name="WarningBanner" Grid.Row="3" Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="4"
                Padding="16,10" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="WarningText" Text="" Foreground="{StaticResource PrimaryBrush}" FontSize="13"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
