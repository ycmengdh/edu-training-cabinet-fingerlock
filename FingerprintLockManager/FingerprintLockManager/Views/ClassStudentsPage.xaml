<Page x:Class="FingerprintLockManager.ClassStudentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="班级学生" Background="{StaticResource BackgroundBrush}">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource IconButton}"
                    Content="&#xE72B;" ToolTip="返回班级管理" Margin="0,0,12,0"
                    Click="BackButton_Click"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="PageTitleText" Text="班级学生" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="正在读取学生" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ImportStudentsButton" Content="导入学生"
                        Style="{StaticResource SecondaryButton}" Click="ImportStudentsButton_Click"/>
                <Button x:Name="AddStudentButton" Content="新增学生" Margin="8,0,0,0"
                        Click="AddStudentButton_Click"/>
                <Button x:Name="BatchEnrollButton" Content="连续录指纹" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="BatchEnrollButton_Click"/>
                <Button x:Name="CabinetSyncButton" Content="批量分配柜机" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="CabinetSyncButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        ToolTip="刷新班级工作台" Margin="8,0,0,0" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,13" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="0.65*"/>
                    <ColumnDefinition Width="0.65*"/>
                    <ColumnDefinition Width="0.65*"/>
                    <ColumnDefinition Width="0.65*"/>
                    <ColumnDefinition Width="0.65*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ClassNameText" Text="班级" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock x:Name="ClassIdText" Text="班级 ID" Style="{StaticResource PageStatusText}"/>
                    <TextBlock x:Name="TeacherText" Text="老师：未分配" Style="{StaticResource PageStatusText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="StudentCountText" Text="0" Style="{StaticResource MetricValueText}"/>
                    <TextBlock Text="学生" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="FingerprintCountText" Text="0" Style="{StaticResource MetricValueText}"/>
                    <TextBlock Text="已录指纹" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock x:Name="AssignedCountText" Text="0" Style="{StaticResource MetricValueText}"/>
                    <TextBlock Text="已分配" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="ReadyCountText" Text="0" Style="{StaticResource MetricValueText}"/>
                    <TextBlock Text="可使用" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                    <TextBlock x:Name="PendingCountText" Text="0" Style="{StaticResource MetricValueText}"
                               Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="待处理" Style="{StaticResource LabelText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="WorkspaceTabs">
            <TabItem Header="学生名单">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="0,6,6,6" Padding="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="StudentDataGrid" BorderThickness="0" IsReadOnly="True"
                                  SelectionMode="Extended" MouseDoubleClick="StudentDataGrid_MouseDoubleClick">
                            <DataGrid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="1.0*"/>
                                <DataGridTextColumn Header="学号" Binding="{Binding UserId}" Width="1.05*"/>
                                <DataGridTextColumn Header="性别" Binding="{Binding GenderText}" Width="66"/>
                                <DataGridTextColumn Header="使用状态" Binding="{Binding WorkflowStatus}" Width="105"/>
                                <DataGridTextColumn Header="用户指纹" Binding="{Binding FingerprintText}" Width="1.25*"
                                                    ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                                <DataGridTextColumn Header="分配柜机" Binding="{Binding CabinetText}" Width="1.4*"
                                                    ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                                <DataGridTemplateColumn Header="操作" Width="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="编辑" Tag="{Binding}" Style="{StaticResource SecondaryButton}"
                                                        Width="58" MinWidth="58" Margin="0,0,6,0"
                                                        Click="EditStudentButton_Click"/>
                                                <Button Content="管理" Tag="{Binding}" Width="58" MinWidth="58"
                                                        Margin="0,0,6,0" Click="ManageStudentButton_Click"/>
                                                <Button Content="删除" Tag="{Binding}" Style="{StaticResource DangerButton}"
                                                        Width="58" MinWidth="58" Click="DeleteStudentButton_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Style="{StaticResource PagerBar}" Margin="8,6,8,8">
                            <Button x:Name="StudentPrevPageButton" Style="{StaticResource SecondaryButton}"
                                    Content="上一页" Width="80" Click="StudentPrevPageButton_Click"/>
                            <TextBlock x:Name="StudentPageInfoText" Style="{StaticResource PagerInfoText}" Text="第 1 / 1 页"/>
                            <Button x:Name="StudentNextPageButton" Style="{StaticResource SecondaryButton}"
                                    Content="下一页" Width="80" Click="StudentNextPageButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="柜机分配">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="0,6,6,6" Padding="1">
                    <DataGrid x:Name="CabinetOverviewGrid" BorderThickness="0" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceNumber}" Width="1.0*"/>
                            <DataGridTextColumn Header="柜机名称" Binding="{Binding DeviceName}" Width="1.3*"/>
                            <DataGridTextColumn Header="链路" Binding="{Binding OnlineText}" Width="88"/>
                            <DataGridTextColumn Header="分配学生" Binding="{Binding StudentCount}" Width="90"/>
                            <DataGridTextColumn Header="可使用" Binding="{Binding ReadyCount}" Width="88"/>
                            <DataGridTextColumn Header="待处理" Binding="{Binding PendingCount}" Width="88"/>
                            <DataGridTemplateColumn Header="操作" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="分配与同步" Tag="{Binding}" Width="96"
                                                Click="OpenCabinetAssignmentButton_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="同步状态">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="0,6,6,6" Padding="1">
                    <DataGrid x:Name="SyncStatusGrid" BorderThickness="0" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="学生" Binding="{Binding StudentName}" Width="1.1*"/>
                            <DataGridTextColumn Header="学号" Binding="{Binding UserId}" Width="1.0*"/>
                            <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceNumber}" Width="1.0*"/>
                            <DataGridTextColumn Header="当前指纹" Binding="{Binding FingerprintText}" Width="1.2*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="1.0*"/>
                            <DataGridTextColumn Header="处理建议" Binding="{Binding ActionText}" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
