<Page x:Class="FingerprintLockManager.SystemLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="系统日志" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="系统日志" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="操作 / 通讯 / 开锁日志统一查看"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButton}"
                    Content="&#xE72C;" ToolTip="刷新当前页签" Click="RefreshButton_Click"
                    VerticalAlignment="Bottom"/>
        </Grid>

        <TabControl x:Name="LogTabs" Grid.Row="1" SelectionChanged="LogTabs_SelectionChanged">
            <!-- 操作日志 -->
            <TabItem Header="操作日志">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="关键词" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <TextBox x:Name="OpKeywordBox" Width="180"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="开始日期" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <DatePicker x:Name="OpStartDatePicker" Width="132"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="结束日期" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <DatePicker x:Name="OpEndDatePicker" Width="132"/>
                            </StackPanel>
                            <Button x:Name="OpQueryButton" Content="查询" Width="82" VerticalAlignment="Bottom"
                                    Click="OpQueryButton_Click"/>
                            <Button x:Name="OpExportButton" Style="{StaticResource SecondaryButton}" Content="导出 XLS"
                                    Width="100" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    Click="OpExportButton_Click"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <DataGrid x:Name="OpDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="150"/>
                                <DataGridTextColumn Header="操作者" Binding="{Binding OperatorId}" Width="100"/>
                                <DataGridTextColumn Header="姓名" Binding="{Binding OperatorName}" Width="100"/>
                                <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="90"/>
                                <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="120"/>
                                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="120"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="70"/>
                                <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock x:Name="OpStatusText" Text="" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="OpPrevButton" Style="{StaticResource SecondaryButton}" Content="上一页"
                                Width="80" Click="OpPrevButton_Click"/>
                        <TextBlock x:Name="OpPageInfoText" Text="第 1 页" Margin="12,0" VerticalAlignment="Center" FontSize="11"/>
                        <Button x:Name="OpNextButton" Style="{StaticResource SecondaryButton}" Content="下一页"
                                Width="80" Click="OpNextButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 通讯日志 -->
            <TabItem Header="通讯日志">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="关键词" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <TextBox x:Name="CommKeywordBox" Width="180"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="开始日期" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <DatePicker x:Name="CommStartDatePicker" Width="132"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="结束日期" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <DatePicker x:Name="CommEndDatePicker" Width="132"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="方向" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CommDirectionBox" Width="100">
                                    <ComboBoxItem Content="全部" Tag="" IsSelected="True"/>
                                    <ComboBoxItem Content="发送" Tag="Transmit"/>
                                    <ComboBoxItem Content="接收" Tag="Receive"/>
                                    <ComboBoxItem Content="状态" Tag="System"/>
                                </ComboBox>
                            </StackPanel>
                            <Button x:Name="CommQueryButton" Content="查询" Width="82" VerticalAlignment="Bottom"
                                    Click="CommQueryButton_Click"/>
                            <Button x:Name="CommExportButton" Style="{StaticResource SecondaryButton}" Content="导出 XLS"
                                    Width="100" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    Click="CommExportButton_Click"/>
                            <Button x:Name="CommClearButton" Style="{StaticResource SecondaryButton}" Content="清空缓存"
                                    Width="90" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    Click="CommClearButton_Click"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <DataGrid x:Name="CommDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single"
                                  AutoGenerateColumns="False" SelectionChanged="CommDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="170"/>
                                <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="70"/>
                                <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="100"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,8,0,0" Padding="10,6" MinHeight="56">
                        <TextBox x:Name="CommDetailBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="11"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock x:Name="CommStatusText" Text="" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="CommPrevButton" Style="{StaticResource SecondaryButton}" Content="上一页"
                                Width="80" Click="CommPrevButton_Click"/>
                        <TextBlock x:Name="CommPageInfoText" Text="第 1 页" Margin="12,0" VerticalAlignment="Center" FontSize="11"/>
                        <Button x:Name="CommNextButton" Style="{StaticResource SecondaryButton}" Content="下一页"
                                Width="80" Click="CommNextButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 开锁日志 -->
            <TabItem Header="开锁日志">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="关键词" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <TextBox x:Name="UnlockKeywordBox" Width="150"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="设备 ID" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <TextBox x:Name="UnlockDeviceIdBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="用户 ID" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <TextBox x:Name="UnlockUserIdBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="结果" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="UnlockResultBox" Width="100">
                                    <ComboBoxItem Content="全部" Tag="" IsSelected="True"/>
                                    <ComboBoxItem Content="成功" Tag="success"/>
                                    <ComboBoxItem Content="失败" Tag="fail"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="开始日期" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <DatePicker x:Name="UnlockStartDatePicker" Width="132"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="结束日期" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                                <DatePicker x:Name="UnlockEndDatePicker" Width="132"/>
                            </StackPanel>
                            <Button x:Name="UnlockQueryButton" Content="查询" Width="82" VerticalAlignment="Bottom"
                                    Click="UnlockQueryButton_Click"/>
                            <Button x:Name="UnlockExportButton" Style="{StaticResource SecondaryButton}" Content="导出 XLS"
                                    Width="100" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    Click="UnlockExportButton_Click"/>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <DataGrid x:Name="UnlockDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                                <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="120"/>
                                <DataGridTextColumn Header="用户 ID" Binding="{Binding UserId}" Width="110"/>
                                <DataGridTextColumn Header="锁号" Binding="{Binding LockId}" Width="60"/>
                                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="90"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="70"/>
                                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock x:Name="UnlockStatusText" Text="" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="UnlockPrevButton" Style="{StaticResource SecondaryButton}" Content="上一页"
                                Width="80" Click="UnlockPrevButton_Click"/>
                        <TextBlock x:Name="UnlockPageInfoText" Text="第 1 页" Margin="12,0" VerticalAlignment="Center" FontSize="11"/>
                        <Button x:Name="UnlockNextButton" Style="{StaticResource SecondaryButton}" Content="下一页"
                                Width="80" Click="UnlockNextButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
