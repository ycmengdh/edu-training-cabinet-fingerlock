<Page x:Class="FingerprintLockManager.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="开锁日志" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="开锁日志" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ExportButton" Style="{StaticResource SecondaryButton}" Click="ExportButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource AppIconFont}" Margin="0,0,8,0"/>
                        <TextBlock Text="导出 CSV"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ArchiveButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="归档并清空" Click="ArchiveButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新日志"
                        Margin="8,0,0,0" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="设备 ID" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                    <TextBox x:Name="DeviceIdFilter" Width="132"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="用户 ID" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                    <TextBox x:Name="UserIdFilter" Width="132"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="结果" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ResultFilterBox" Width="110">
                        <ComboBoxItem Content="全部" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="成功" Tag="success"/>
                        <ComboBoxItem Content="失败" Tag="fail"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="开始日期" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                    <DatePicker x:Name="StartDatePicker" Width="132"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="结束日期" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                    <DatePicker x:Name="EndDatePicker" Width="132"/>
                </StackPanel>
                <Button x:Name="QueryButton" Content="查询" Width="82" VerticalAlignment="Bottom" Click="QueryButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12" Padding="12,8">
            <TextBlock x:Name="FailAggregateText" Text="失败原因聚合：-" FontSize="11"
                       Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Panel}">
            <DataGrid x:Name="LogDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="130"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="用户 ID" Binding="{Binding UserId}" Width="120"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="锁号" Binding="{Binding LockId}" Width="64"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="110"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="84"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"
                                        ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="PrevPageButton" Style="{StaticResource SecondaryButton}" Content="上一页" Width="80" Click="PrevPageButton_Click"/>
            <TextBlock x:Name="PageInfoText" Text="第 1 页" Margin="12,0" VerticalAlignment="Center" FontSize="11"/>
            <Button x:Name="NextPageButton" Style="{StaticResource SecondaryButton}" Content="下一页" Width="80" Click="NextPageButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
