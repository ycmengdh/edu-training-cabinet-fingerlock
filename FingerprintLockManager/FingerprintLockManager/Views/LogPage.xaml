<Page x:Class="FingerprintLockManager.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="日志查看"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="日志查看" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>

        <!-- 筛选区 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="设备ID：" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>
                    <TextBox x:Name="DeviceIdFilter" Width="140"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="用户ID：" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>
                    <TextBox x:Name="UserIdFilter" Width="140"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="开始时间：" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>
                    <DatePicker x:Name="StartDatePicker" Width="140"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="结束时间：" Style="{StaticResource LabelText}" Margin="0,0,8,0"/>
                    <DatePicker x:Name="EndDatePicker" Width="140"/>
                </StackPanel>
                <Button Content="查询" Click="QueryButton_Click"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RefreshButton_Click"/>
                <Button Content="导出CSV" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ExportButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- 日志列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="LogDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                    <DataGridTextColumn Header="设备ID" Binding="{Binding DeviceId}" Width="130"/>
                    <DataGridTextColumn Header="用户ID" Binding="{Binding UserId}" Width="120"/>
                    <DataGridTextColumn Header="锁号" Binding="{Binding LockId}" Width="60"/>
                    <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="110"/>
                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="80"/>
                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
