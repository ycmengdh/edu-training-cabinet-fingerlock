<Window x:Class="FingerprintLockManager.DeviceConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备 AP 配置" Height="650" Width="760" MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="设备 AP 配置" Style="{StaticResource TitleText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="未连接" Margin="7,0,0,0" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ReadConfigButton" Style="{StaticResource SecondaryButton}" Content="读取配置"
                        Click="ReadConfigButton_Click" IsEnabled="False"/>
                <Button x:Name="ConnectButton" Content="连接设备" Margin="8,0,0,0" Click="ConnectButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="AP 地址" Style="{StaticResource LabelText}" Margin="0,0,10,0"/>
                <TextBox x:Name="ApIpBox" Grid.Column="1" Text="192.168.4.1" Margin="0,0,18,0"/>
                <TextBlock Grid.Column="2" Text="端口" Style="{StaticResource LabelText}" Margin="0,0,10,0"/>
                <TextBox x:Name="ApPortBox" Grid.Column="3" Text="8888"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="设备 ID" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="DeviceIdBox" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="设备名称" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="DeviceNameBox"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="WiFi SSID" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="WifiSsidBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="WiFi 密码" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="WifiPasswordBox"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="上位机服务器 IP" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="ServerIpBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="上位机服务器端口" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="ServerPortBox"/>
                    </StackPanel>

                    <Border Grid.Row="3" Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,12">
                        <CheckBox x:Name="StaticIpCheckBox" Content="启用静态 IP" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="静态 IP" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="StaticIpBox"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="网关" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="GatewayBox"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0">
                        <TextBlock Text="子网掩码" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="SubnetBox"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RebootButton" Content="重启设备" Style="{StaticResource DangerButton}" Click="RebootButton_Click"/>
            <Button x:Name="CloseButton" Grid.Column="2" Content="关闭" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
            <Button x:Name="WriteConfigButton" Grid.Column="3" Content="下发配置" Margin="8,0,0,0" Click="WriteConfigButton_Click"/>
        </Grid>
    </Grid>
</Window>
