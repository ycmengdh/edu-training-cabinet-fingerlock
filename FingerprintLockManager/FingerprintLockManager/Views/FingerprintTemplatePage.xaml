<Page x:Class="FingerprintLockManager.FingerprintTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="指纹模板库" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="指纹模板库" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="采集后未分配的模板暂存于此，可批量下发到柜子"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" ToolTip="刷新模板列表" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UploadAllButton" Style="{StaticResource SecondaryButton}" Click="UploadAllButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                        <TextBlock Text="上传全部到 SD"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DistributeButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="DistributeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                        <TextBlock Text="批量下发到柜子"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteSelectedButton" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteSelectedButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="删除选中" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid x:Name="TemplateDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="指纹 ID" Binding="{Binding FingerprintId}" Width="80"/>
                    <DataGridTextColumn Header="关联用户" Binding="{Binding DisplayUser}" Width="180"/>
                    <DataGridTextColumn Header="手指索引" Binding="{Binding FingerIndex}" Width="80"/>
                    <DataGridTextColumn Header="录入时间" Binding="{Binding EnrollTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="模板大小" Binding="{Binding TemplateSize, StringFormat={}{0} B}" Width="90"/>
                    <DataGridTextColumn Header="采集设备" Binding="{Binding SourceDevice}" Width="120"/>
                    <DataGridTextColumn Header="备份状态" Binding="{Binding BackupStatusText}" Width="100"/>
                    <DataGridTemplateColumn Header="操作" Width="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="关联用户" Tag="{Binding FingerprintId}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButton}" Click="BindUserButton_Click"/>
                                    <Button Content="下发" Tag="{Binding FingerprintId}" Margin="0,0,6,0"
                                            Click="DistributeOneButton_Click"/>
                                    <Button Content="删除" Tag="{Binding FingerprintId}"
                                            Style="{StaticResource DangerButton}" Click="DeleteOneButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ToolbarPanel}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SummaryText" Text="共 0 个模板，0 个未关联用户"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
