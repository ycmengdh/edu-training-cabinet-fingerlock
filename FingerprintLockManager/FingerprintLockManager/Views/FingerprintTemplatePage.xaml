<Page x:Class="FingerprintLockManager.FingerprintTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="指纹模板库" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="指纹模板库" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText"
                           Text="用户可存多枚指纹；下发到柜机时每柜每用户只占 1 个槽位（模块约 200 槽），在学生详情按柜选择当前指纹"
                           Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" ToolTip="刷新模板列表" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UploadAllButton" Style="{StaticResource SecondaryButton}" Click="UploadAllButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74A;" FontFamily="{StaticResource AppIconFont}" Margin="0,0,8,0"/>
                        <TextBlock Text="上传全部到 SD"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DistributeButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="DistributeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE968;" FontFamily="{StaticResource AppIconFont}" Margin="0,0,8,0"/>
                        <TextBlock Text="批量下发到柜子"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TestFingerprintButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Click="TestFingerprintButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE928;" FontFamily="{StaticResource AppIconFont}" Margin="0,0,8,0"/>
                        <TextBlock Text="指纹测试"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteSelectedButton" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteSelectedButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="删除选中" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid x:Name="TemplateDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Extended">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="指纹 ID" Binding="{Binding FingerprintId}" Width="80"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="关联用户" Binding="{Binding DisplayUser}" Width="180"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="手指索引" Binding="{Binding FingerIndex}" Width="80"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="录入时间" Binding="{Binding EnrollTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="模板大小" Binding="{Binding TemplateSize, StringFormat={}{0} B}" Width="90"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="采集设备" Binding="{Binding SourceDevice}" Width="120"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="备份状态" Binding="{Binding BackupStatusText}" Width="100"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="操作" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="关联用户" Tag="{Binding FingerprintId}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButton}" Click="BindUserButton_Click"/>
                                    <Button Content="下发" Tag="{Binding FingerprintId}" Margin="0,0,6,0"
                                            Click="DistributeOneButton_Click"/>
                                    <Button Content="测试" Tag="{Binding FingerprintId}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButton}" Click="TestOneButton_Click"/>
                                    <Button Content="删除" Tag="{Binding FingerprintId}"
                                            Style="{StaticResource DangerButton}" Click="DeleteOneButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" Text="共 0 个模板，0 个未关联用户"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11"
                       VerticalAlignment="Center"/>
            <StackPanel Style="{StaticResource PagerBar}" HorizontalAlignment="Right" Margin="0">
                <Button x:Name="PrevPageButton" Style="{StaticResource SecondaryButton}" Content="上一页" Width="80"
                        Click="PrevPageButton_Click"/>
                <TextBlock x:Name="PageInfoText" Style="{StaticResource PagerInfoText}" Text="第 1 / 1 页"/>
                <Button x:Name="NextPageButton" Style="{StaticResource SecondaryButton}" Content="下一页" Width="80"
                        Click="NextPageButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
