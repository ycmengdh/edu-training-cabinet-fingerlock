<Page x:Class="FingerprintLockManager.FingerprintEnrollPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="指纹录入"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="指纹录入" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="AS608 要求按 4 次采集 + 2 次验证 = 共 6 次按手指。可在任意柜子录入；录入后存根节点 SD 卡，本机不存。老师录入后自动下发到所有柜子。"
                   Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,28,0,12"
                   TextWrapping="Wrap"/>

        <!-- 主体：左右两栏 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：录入配置 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="录入配置" FontWeight="Bold" Margin="0,0,0,12"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="用户" Margin="0,0,0,6"/>
                    <ComboBox x:Name="UserCombo" Margin="0,0,0,16" SelectionChanged="UserCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding UserId}" FontSize="11"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="录入柜子（任意一台均可）" Margin="0,0,0,6"/>
                    <ComboBox x:Name="DeviceCombo" Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DeviceName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DeviceId}" FontSize="11"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="指纹 ID（AS608 模块内页号）" Margin="0,0,0,6"/>
                    <TextBox x:Name="FingerprintIdBox" Margin="0,0,0,16" IsReadOnly="True"/>

                    <TextBlock x:Name="UserStatusText" Text="请选择用户" Margin="0,0,0,16"
                               Foreground="{StaticResource SubTextBrush}" FontSize="11" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="开始录入" Click="StartButton_Click"/>
                        <Button x:Name="CancelButton" Content="取消录入" Style="{StaticResource DangerButton}"
                                Margin="12,0,0,0" Click="CancelButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 右侧：录入进度 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="录入进度" FontWeight="Bold" Margin="0,0,0,16"
                               Foreground="{StaticResource TextBrush}"/>

                    <!-- 6 步进度指示 -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <StackPanel x:Name="StepPanel" Orientation="Horizontal" Margin="0,0,0,24">
                            <!-- 6 个步骤圆圈，代码动态生成 -->
                        </StackPanel>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="当前步骤" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="CurrentStepText" Text="尚未开始" FontSize="16" FontWeight="Bold"
                                           Margin="0,6,0,0" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="操作提示" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="StepDescriptionText" Text="点击「开始录入」按钮启动指纹采集流程"
                                           FontSize="13" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ResultBanner" Style="{StaticResource Card}" Padding="16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ResultTitle" Text="" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="ResultMessage" Text="" FontSize="12" Margin="0,6,0,0"
                                           Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 底部状态 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
