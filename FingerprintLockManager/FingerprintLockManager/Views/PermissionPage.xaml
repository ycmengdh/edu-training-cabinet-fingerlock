<Page x:Class="FingerprintLockManager.PermissionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="个人权限" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="个人权限" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButton}"
                    Content="&#xE72C;" ToolTip="刷新权限" Click="RefreshButton_Click" VerticalAlignment="Bottom"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Padding="14,0">
                        <TextBlock Text="用户" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                    </Border>
                    <ListBox x:Name="UserListBox" Grid.Row="1" BorderThickness="0" SelectionChanged="UserListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding UserId}" FontSize="10" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Role}" FontSize="10" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <Border Padding="18,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedUserName" Text="未选择用户" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectedUserFp" Text="指纹 ID：-" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border x:Name="RoleBadge" Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="3" Padding="10,4">
                                <TextBlock x:Name="SelectedUserRole" Text="-" FontSize="11" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="锁权限" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Column="1" Text="来源" Style="{StaticResource LabelText}" HorizontalAlignment="Right"/>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10,0">
                            <Grid><CheckBox x:Name="Lock0CheckBox" Content="Lock 0   系统锁" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lock0Source" Text="角色默认" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}"/></Grid>
                        </Border>
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="10,0">
                            <Grid><CheckBox x:Name="Lock1CheckBox" Content="Lock 1   实训柜 1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lock1Source" Text="角色默认" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}"/></Grid>
                        </Border>
                        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10,0">
                            <Grid><CheckBox x:Name="Lock2CheckBox" Content="Lock 2   实训柜 2" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lock2Source" Text="角色默认" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}"/></Grid>
                        </Border>
                        <Border Grid.Row="4" Grid.ColumnSpan="2" Padding="10,0">
                            <Grid><CheckBox x:Name="Lock3CheckBox" Content="Lock 3   实训柜 3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lock3Source" Text="角色默认" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}"/></Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Padding="14,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ResetButton" Content="按模板重置" Style="{StaticResource SecondaryButton}" Click="ResetButton_Click"/>
                            <Button x:Name="SaveButton" Content="保存权限" Margin="8,0,0,0" Click="SaveButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
