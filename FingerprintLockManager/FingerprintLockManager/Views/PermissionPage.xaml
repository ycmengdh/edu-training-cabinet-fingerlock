<Page x:Class="FingerprintLockManager.PermissionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="权限管理"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="权限管理" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>

        <!-- 主体：左侧用户列表 + 右侧权限勾选 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧用户列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="用户列表" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    </Border>
                    <ListBox x:Name="UserListBox" Grid.Row="1" BorderThickness="0"
                             SelectionChanged="UserListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding UserId}" FontSize="11"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧权限勾选 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 选中用户信息 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="当前用户" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="SelectedUserName" Text="请选择左侧用户" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource TextBrush}"/>
                            <Border x:Name="RoleBadge" Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="3" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedUserRole" Text="-" FontSize="12"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SelectedUserFp" Text="指纹ID：未分配" Margin="0,6,0,0"
                                   Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    </StackPanel>

                    <!-- 4把锁的权限勾选框 -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <TextBlock Text="锁权限设置" FontWeight="Bold" Margin="0,0,0,12"
                                   Foreground="{StaticResource TextBrush}"/>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="Lock0CheckBox" Content="Lock0 - 系统锁" Margin="0,0,0,0"
                                          VerticalContentAlignment="Center" IsEnabled="False"/>
                                <TextBlock Text="（仅管理员可勾选）" Margin="12,0,0,0" FontSize="11"
                                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                            <CheckBox x:Name="Lock1CheckBox" Content="Lock1 - 实训柜1" VerticalContentAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                            <CheckBox x:Name="Lock2CheckBox" Content="Lock2 - 实训柜2" VerticalContentAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12">
                            <CheckBox x:Name="Lock3CheckBox" Content="Lock3 - 实训柜3" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- 保存按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="SaveButton" Content="保存权限" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
