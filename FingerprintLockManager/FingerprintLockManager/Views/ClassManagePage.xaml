<Page x:Class="FingerprintLockManager.ClassManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="班级管理" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="班级管理" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="AddButton" Content="添加班级" Click="AddButton_Click"/>
                <Button x:Name="EditButton" Style="{StaticResource SecondaryButton}" Content="编辑" Margin="8,0,0,0" Click="EditButton_Click"/>
                <Button x:Name="ToggleButton" Style="{StaticResource SecondaryButton}" Content="启用/停用" Margin="8,0,0,0" Click="ToggleButton_Click"/>
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="删除" Margin="8,0,0,0" Click="DeleteButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <DataGrid x:Name="ClassDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="班级 ID" Binding="{Binding ClassId}" Width="180"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
