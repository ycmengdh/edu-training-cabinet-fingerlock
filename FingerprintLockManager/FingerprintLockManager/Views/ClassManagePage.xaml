<Page x:Class="FingerprintLockManager.ClassManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="班级管理"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="班级管理" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="管理员可管理所有班级；老师只能管理自己负责的班级。创建班级时必须指定负责老师。"
                   Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,28,0,12"/>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ 新建班级" Click="AddClassButton_Click"/>
                <Button Content="查看学生" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Click="ViewStudentsButton_Click"/>
                <Button Content="删除班级" Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                        Click="DeleteClassButton_Click"/>
                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 班级列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="ClassDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="班级ID" Binding="{Binding ClassId}" Width="140"/>
                    <DataGridTextColumn Header="班级名称" Binding="{Binding ClassName}" Width="160"/>
                    <DataGridTextColumn Header="负责老师" Binding="{Binding TeacherUserId}" Width="140"/>
                    <DataGridTextColumn Header="学生人数" Binding="{Binding StudentCount}" Width="100"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部学生列表区（选中班级后展开） -->
        <Border x:Name="StudentSection" Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="班级学生列表" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="SelectedClassText" Text="" Margin="12,0,0,0"
                               Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                </StackPanel>
                <DataGrid x:Name="StudentDataGrid" Grid.Row="1" Height="180"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="用户ID" Binding="{Binding UserId}" Width="140"/>
                        <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="指纹ID" Binding="{Binding FingerprintId}" Width="100"/>
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
