<Page x:Class="FingerprintLockManager.ClassManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="班级管理" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="班级管理" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <ScrollViewer Grid.Column="1" Style="{StaticResource ToolbarScroll}" VerticalAlignment="Bottom" MaxWidth="700">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddButton" Content="添加班级" Click="AddButton_Click"/>
                    <Button x:Name="EditButton" Style="{StaticResource SecondaryButton}" Content="编辑" Margin="8,0,0,0" Click="EditButton_Click"/>
                    <Button x:Name="OpenButton" Style="{StaticResource SecondaryButton}" Content="打开班级" Margin="8,0,0,0" Click="OpenButton_Click"/>
                    <Button x:Name="CabinetSyncButton" Style="{StaticResource SecondaryButton}" Content="柜机分配同步" Margin="8,0,0,0" Click="CabinetSyncButton_Click"/>
                    <Button x:Name="ToggleButton" Style="{StaticResource SecondaryButton}" Content="启用/停用" Margin="8,0,0,0" Click="ToggleButton_Click"/>
                    <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="删除" Margin="8,0,0,0" Click="DeleteButton_Click"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0" Click="RefreshButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <DataGrid x:Name="ClassDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single"
                      MouseDoubleClick="ClassDataGrid_MouseDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="班级 ID" Binding="{Binding ClassId}" Width="160"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="班级名称" Binding="{Binding Name}" Width="190"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="老师" Binding="{Binding TeacherText}" Width="1.2*"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="学生数" Binding="{Binding StudentCount}" Width="86"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="86"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="150"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="操作" Width="216">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="打开" Tag="{Binding}" Style="{StaticResource SecondaryButton}"
                                            Width="62" MinWidth="62" Margin="0,0,6,0"
                                            Click="OpenRowButton_Click"/>
                                    <Button Content="分配" Tag="{Binding}" Style="{StaticResource SecondaryButton}"
                                            Width="62" MinWidth="62" Margin="0,0,6,0"
                                            Click="CabinetSyncRowButton_Click"/>
                                    <Button Content="删除" Tag="{Binding}" Style="{StaticResource DangerButton}"
                                            Width="62" MinWidth="62" Click="DeleteRowButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
