<Page x:Class="FingerprintLockManager.BackupRestorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="备份与还原"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="备份与还原" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="每次系统操作前会自动备份根节点数据。备份仅用于还原，数据以根节点为准。还原前会自动备份当前状态。"
                   Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,28,0,12"
                   TextWrapping="Wrap"/>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="立即手动备份" Click="ManualBackupButton_Click"/>
                <Button Content="清理过期备份" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Click="CleanupButton_Click"/>
                <Button Content="刷新列表" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 备份记录列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="备份记录（最近 100 条）" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <DataGrid x:Name="BackupDataGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="备份ID" Binding="{Binding BackupId}" Width="160"/>
                        <DataGridTextColumn Header="触发操作" Binding="{Binding TriggerAction}" Width="*"/>
                        <DataGridTextColumn Header="操作人" Binding="{Binding OperatorUserId}" Width="120"/>
                        <DataGridTextColumn Header="文件大小" Binding="{Binding FileSizeText}" Width="100"/>
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                        <DataGridTemplateColumn Header="操作" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="还原" Style="{StaticResource SecondaryButton}"
                                            Padding="8,4" Click="RestoreButton_Click"
                                            Tag="{Binding BackupId}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
