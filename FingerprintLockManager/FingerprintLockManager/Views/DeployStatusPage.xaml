<Page x:Class="FingerprintLockManager.DeployStatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="下发状态监控"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="下发状态监控" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="老师指纹广播后，每台柜子都应收到。未收到的柜子可手动重发。"
                   Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,28,0,12"/>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="刷新任务列表" Click="RefreshButton_Click"/>
                <Button Content="重发失败项" Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                        Click="RetryButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 上：任务列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="下发任务列表（最近 50 条）" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </Border>
                <DataGrid x:Name="TaskDataGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          SelectionChanged="TaskDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="任务ID" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding TaskTypeText}" Width="140"/>
                        <DataGridTextColumn Header="目标用户" Binding="{Binding UserId}" Width="140"/>
                        <DataGridTextColumn Header="目标柜子" Binding="{Binding DeviceId}" Width="120"/>
                        <DataGridTextColumn Header="进度" Binding="{Binding ProgressText}" Width="120"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100"/>
                        <DataGridTextColumn Header="发起时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 下：状态明细 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="每台柜子的接收状态" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="SelectedTaskText" Text="" Margin="12,0,0,0"
                                   Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <DataGrid x:Name="StatusDataGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="柜子ID" Binding="{Binding DeviceId}" Width="140"/>
                        <DataGridTextColumn Header="接收状态" Binding="{Binding StatusText}" Width="120"/>
                        <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*"/>
                        <DataGridTextColumn Header="重试次数" Binding="{Binding RetryCount}" Width="100"/>
                        <DataGridTextColumn Header="确认时间" Binding="{Binding AckTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
