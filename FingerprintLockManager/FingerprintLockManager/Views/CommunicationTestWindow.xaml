<Window x:Class="FingerprintLockManager.CommunicationTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="根节点通讯测试" Height="650" Width="920" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="根节点通讯测试" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="TransportDescriptionText" Text="正在读取链路配置"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#172329" CornerRadius="4" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TX " Foreground="#91A2A8" FontSize="11"/>
                    <TextBlock x:Name="SentCountText" Text="0" Foreground="White" FontFamily="Cascadia Mono" FontSize="11"/>
                    <TextBlock Text="   RX " Foreground="#91A2A8" FontSize="11"/>
                    <TextBlock x:Name="ReceivedCountText" Text="0" Foreground="White" FontFamily="Cascadia Mono" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,14">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PhysicalStatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="物理链路" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="PhysicalStatusText" Text="未连接" FontWeight="SemiBold" Margin="16,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ProtocolStatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="协议帧" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ProtocolStatusText" Text="未收到" FontWeight="SemiBold" Margin="16,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RootStatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="根节点" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="RootStatusText" Text="未注册" FontWeight="SemiBold" Margin="16,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StorageStatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="SD 数据" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="StorageStatusText" Text="未知" FontWeight="SemiBold" Margin="16,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="发送 REGISTER 测试" Width="150" Click="SendTestButton_Click"/>
                <Button Grid.Column="1" Content="清空记录" Width="92" Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="ClearButton_Click"/>
                <Button Grid.Column="2" Content="复制全部" Width="92" Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="CopyButton_Click"/>
                <TextBlock x:Name="TestResultText" Grid.Column="3" Text="测试会发送正确的二进制协议帧"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#172329" CornerRadius="4,4,0,0" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="94"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间" Foreground="#B8C4C8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="方向" Foreground="#B8C4C8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="类型" Foreground="#B8C4C8" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="数据" Foreground="#B8C4C8" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ListBox x:Name="TraceList" Grid.Row="1" ItemsSource="{Binding TraceEntries}"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="94"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Mono" FontSize="10"
                                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <Border x:Name="DirectionBadge" Grid.Column="1" Background="#E9EEEC" CornerRadius="3"
                                        Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <TextBlock x:Name="DirectionLabel" Text="{Binding DirectionText}" FontSize="10"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Top" Margin="0,3,8,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Content}" FontFamily="Cascadia Mono" FontSize="10.5"
                                           TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,3,4,3"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Direction}" Value="Transmit">
                                    <Setter TargetName="DirectionBadge" Property="Background" Value="#E7F3F0"/>
                                    <Setter TargetName="DirectionLabel" Property="Foreground" Value="#16705F"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Direction}" Value="Receive">
                                    <Setter TargetName="DirectionBadge" Property="Background" Value="#FFF1DC"/>
                                    <Setter TargetName="DirectionLabel" Property="Foreground" Value="#9A6112"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="LastErrorText" Text="提示：普通串口助手发送纯文本不会得到协议应答"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="关闭" Width="82" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
