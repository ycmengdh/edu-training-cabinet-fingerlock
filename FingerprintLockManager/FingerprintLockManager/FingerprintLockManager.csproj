<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 输出类型与目标框架 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 单文件独立编译配置：发布后单 exe，无需安装 .NET 运行时 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- 程序集信息 -->
    <AssemblyName>FingerprintLockManager</AssemblyName>
    <Product>实训柜指纹权限管理系统</Product>
    <Company>学校实训中心</Company>
    <Version>1.0.0</Version>
    <RootNamespace>FingerprintLockManager</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON 序列化 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- USB 串口通讯（与 Mesh 根节点 USB 双链路） -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

</Project>
