<Window x:Class="CabinetLock.MaintenanceModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="柜子维护模式" Width="480" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="远程维护模式" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="DeviceText" Grid.Row="1" Margin="0,5,0,18"
                   Style="{StaticResource PageStatusText}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Row="2" Text="允许现场按键开启的锁" Style="{StaticResource LabelText}"/>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <CheckBox x:Name="Lock0Check" Content="系统锁（Lock 1）" IsChecked="True" Margin="0,0,0,8"/>
            <CheckBox x:Name="Lock1Check" Content="实训柜门 1（Lock 2）" IsChecked="True" Margin="0,0,0,8"/>
            <CheckBox x:Name="Lock2Check" Content="实训柜门 2（Lock 3）" IsChecked="True" Margin="0,0,0,8"/>
            <CheckBox x:Name="Lock3Check" Content="实训柜门 3（Lock 4）" IsChecked="True"/>
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SubTextBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Width="80" Click="CloseButton_Click"/>
            <Button x:Name="ExitButton" Content="退出维护" Style="{StaticResource SecondaryButton}"
                    Width="96" Margin="8,0,0,0" Click="ExitButton_Click"/>
            <Button x:Name="EnterButton" Content="进入维护" Width="96" Margin="8,0,0,0"
                    Click="EnterButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
