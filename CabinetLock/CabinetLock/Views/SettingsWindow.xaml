<local:BorderlessWindow x:Class="CabinetLock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="系统设置" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="系统设置" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="StatusText" Text="修改后将保存到本地 app_config.json 并重启链路"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="外观" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                <TextBlock Text="界面主题" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="AppearanceThemeBox" Margin="0,0,0,20"/>

                <TextBlock Text="连接" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                <TextBlock Text="传输类型" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="TransportTypeBox" Margin="0,0,0,14" SelectionChanged="TransportTypeBox_SelectionChanged"/>

                <StackPanel x:Name="SerialPanel">
                    <TextBlock Text="串口" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SerialPortBox" IsEditable="True" Margin="0,0,0,14"/>
                    <TextBlock Text="波特率" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="BaudRateBox" Margin="0,0,0,14"/>
                </StackPanel>

                <StackPanel x:Name="TcpClientPanel">
                    <TextBlock Text="TCP 主机" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TcpHostBox" Margin="0,0,0,14"/>
                    <TextBlock Text="TCP 客户端端口" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TcpClientPortBox" Margin="0,0,0,14"/>
                </StackPanel>

                <StackPanel x:Name="TcpServerPanel">
                    <TextBlock Text="TCP 服务端端口" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TcpServerPortBox" Margin="0,0,0,14"/>
                </StackPanel>

                <TextBlock Text="离线超时（秒）" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <TextBox x:Name="OfflineTimeoutBox" Margin="0,0,0,14"/>

                <CheckBox x:Name="HmacEnabledBox" Content="启用消息 HMAC（需与设备密钥一致）" Margin="0,0,0,10"/>
                <TextBlock Text="HMAC 密钥" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="HmacKeyBox" Margin="0,0,0,8"/>
                <TextBlock Text="默认关闭，正式部署时再开启。" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="保存并应用" Width="110" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Margin="10,0,0,0"
                    Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
