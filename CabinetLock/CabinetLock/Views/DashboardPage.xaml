<Page x:Class="CabinetLock.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="运行总览" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="运行总览" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="正在读取根节点运行状态"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButton}"
                    Content="&#xE72C;" ToolTip="刷新运行状态" Click="RefreshButton_Click"
                    VerticalAlignment="Bottom"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusMetric}" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LinkStatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LinkMetricLabel" Text="根节点链路" Style="{StaticResource LabelText}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="LinkValueText" Grid.Row="1" Text="未连接" Style="{StaticResource MetricValueText}" Margin="0,8,0,4"/>
                    <TextBlock x:Name="LinkDetailText" Grid.Row="2" Text="等待通信链路" Foreground="{StaticResource SubTextBrush}" FontSize="10"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatusMetric}" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DeviceMetricLabel" Text="柜子在线" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="DeviceValueText" Grid.Row="1" Text="0 / 0" Style="{StaticResource MetricValueText}" Margin="0,8,0,4"/>
                    <TextBlock x:Name="DeviceDetailText" Grid.Row="2" Text="尚无设备数据" Foreground="{StaticResource SubTextBrush}" FontSize="10"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource StatusMetric}" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="SyncMetricLabel" Text="权限一致" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="SyncValueText" Grid.Row="1" Text="0 / 0" Style="{StaticResource MetricValueText}" Margin="0,8,0,4"/>
                    <TextBlock x:Name="SyncDetailText" Grid.Row="2" Text="等待版本信息" Foreground="{StaticResource SubTextBrush}" FontSize="10"/>
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource StatusMetric}" HorizontalAlignment="Stretch" Cursor="Hand"
                    MouseLeftButtonUp="PendingSyncMetric_Click" ToolTip="点击查看待同步队列">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PendingSyncMetricLabel" Text="待同步" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="PendingSyncValueText" Grid.Row="1" Text="0" Style="{StaticResource MetricValueText}" Margin="0,8,0,4"/>
                    <TextBlock x:Name="PendingSyncDetailText" Grid.Row="2" Text="柜机队列空闲" Foreground="{StaticResource SubTextBrush}" FontSize="10"/>
                </Grid>
            </Border>

            <Border Grid.Column="8" Style="{StaticResource StatusMetric}" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="StudentBindMetricLabel" Text="学生绑定" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="StudentBindValueText" Grid.Row="1" Text="0 / 0" Style="{StaticResource MetricValueText}" Margin="0,8,0,4"/>
                    <TextBlock x:Name="StudentBindDetailText" Grid.Row="2" Text="已分配权限 / 总学生" Foreground="{StaticResource SubTextBrush}" FontSize="10"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="14,0">
                        <Grid>
                            <TextBlock Text="当前告警" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AlertCountText" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="AlertDataGrid" Grid.Row="1" BorderThickness="0" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="48"
                              MouseDoubleClick="AlertDataGrid_MouseDoubleClick"
                              ToolTip="双击柜子相关告警可打开详情">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="级别" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="120"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="问题" Binding="{Binding Message}" Width="*"
                                                ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                            <DataGridTextColumn Header="建议" Binding="{Binding ActionHint}" Width="180"
                                                ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Padding="14,0">
                            <Grid>
                                <TextBlock Text="实时柜机" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LiveEventCountText" Text="0 条" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="LiveEventDataGrid" Grid.Row="1" BorderThickness="0" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="None"
                                  MouseDoubleClick="LiveEventDataGrid_MouseDoubleClick"
                                  ToolTip="双击可打开对应柜子">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding TimeText}" Width="52"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Binding="{Binding DeviceText}" Width="88"
                                                    ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                                <DataGridTextColumn Binding="{Binding Summary}" Width="*"
                                                    ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Padding="14,0">
                            <Grid>
                                <TextBlock Text="最近开锁" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PendingLogText" Text="待传 0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="RecentLogDataGrid" Grid.Row="1" BorderThickness="0" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding CreateTime, StringFormat=MM-dd HH:mm}" Width="72"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="柜子" Binding="{Binding DeviceId}" Width="80"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="用户" Binding="{Binding DisplayUserId}" Width="*"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="52"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="RefreshTimeText" Grid.Row="3" HorizontalAlignment="Right"
                   Foreground="{StaticResource SubTextBrush}" FontSize="10" Margin="0,10,0,0"/>
    </Grid>
</Page>
