<Page x:Class="CabinetLock.CabinetManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="实训柜管理" Background="{StaticResource BackgroundBrush}">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="实训柜管理" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="正在读取柜子状态" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="MaintenancePasswordButton" Style="{StaticResource SecondaryButton}"
                        Content="维护密码" Click="MaintenancePasswordButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="MaintenanceModeButton" Style="{StaticResource SecondaryButton}"
                        Content="维护模式" Click="MaintenanceModeButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="FirmwareUpgradeButton" Style="{StaticResource SecondaryButton}"
                        Content="柜机升级" Click="FirmwareUpgradeButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="ResyncButton" Style="{StaticResource SecondaryButton}"
                        Content="同步全部柜子" ToolTip="逐柜校验并补写用户指纹，再提交柜门权限"
                        Click="ResyncButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" ToolTip="仅更新柜子数据，保留当前筛选、排序和表格布局" Margin="8,0,0,0"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Padding="0" Margin="0,0,0,14">
            <Grid Height="72">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalCabinetText" Text="0" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="柜子总数" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="36" Background="{StaticResource BorderBrush}"/>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="OnlineCabinetText" Text="0" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="当前在线" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <Border Grid.Column="3" Width="1" Height="36" Background="{StaticResource BorderBrush}"/>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="SyncedCabinetText" Text="0" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="完整已同步" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <Border Grid.Column="5" Width="1" Height="36" Background="{StaticResource BorderBrush}"/>
                <StackPanel Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="AttentionCabinetText" Text="0" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="需要处理" Style="{StaticResource LabelText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="柜子列表" Style="{StaticResource SectionTitleText}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="VisibleCountText" Text="0 台"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="搜索" Style="{StaticResource LabelText}" Margin="0,0,7,0"/>
                        <TextBox x:Name="CabinetSearchBox" Width="180" Height="34"
                                 ToolTip="按设备编号、名称、MAC 或通讯 ID 搜索" TextChanged="CabinetFilter_Changed"/>
                        <ComboBox x:Name="OnlineStatusFilter" Width="112" Height="34" Margin="8,0,0,0"
                                  SelectionChanged="CabinetFilter_Changed">
                            <ComboBoxItem Content="全部在线状态" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="在线" Tag="online"/>
                            <ComboBoxItem Content="离线" Tag="offline"/>
                        </ComboBox>
                        <ComboBox x:Name="PermissionSyncFilter" Width="124" Height="34" Margin="8,0,0,0"
                                   SelectionChanged="CabinetFilter_Changed">
                            <ComboBoxItem Content="全部同步状态" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="完整已同步" Tag="synced"/>
                            <ComboBoxItem Content="需要同步" Tag="lagging"/>
                            <ComboBoxItem Content="待核验/未知" Tag="unknown"/>
                        </ComboBox>
                        <ComboBox x:Name="MaintenanceStatusFilter" Width="112" Height="34" Margin="8,0,0,0"
                                  SelectionChanged="CabinetFilter_Changed">
                            <ComboBoxItem Content="全部维护状态" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="正常" Tag="normal"/>
                            <ComboBoxItem Content="维护" Tag="maintenance"/>
                        </ComboBox>
                        <Button x:Name="DeleteSelectedCabinetsButton" Style="{StaticResource DangerButton}"
                                Height="34" Margin="8,0,0,0" Visibility="Collapsed"
                                Click="DeleteSelectedCabinetsButton_Click" ToolTip="删除已勾选的柜子">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,0,7,0"/>
                                <TextBlock x:Name="DeleteSelectedCabinetsText" Text="删除选中"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="CabinetDataGrid" BorderThickness="0" IsReadOnly="True"
                              SelectionMode="Extended" MouseDoubleClick="CabinetDataGrid_MouseDoubleClick"
                              KeyDown="CabinetDataGrid_KeyDown"
                              PreviewMouseWheel="CabinetDataGrid_PreviewMouseWheel"
                              ScrollViewer.ScrollChanged="CabinetDataGrid_ScrollChanged"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AttentionKind}" Value="offline">
                                        <Setter Property="Opacity" Value="0.78"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="MaintenanceSelectionColumn" Width="48">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="SelectAllMaintenanceCheckBox" IsThreeState="True"
                                              HorizontalAlignment="Center" Click="SelectAllMaintenanceCheckBox_Click"
                                              ToolTip="全选或取消当前筛选结果中的柜子"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  Click="CabinetSelectionCheckBox_Click"
                                                  ToolTip="选择该柜机进行批量操作"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding OnlineStatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceNumber}" Width="*" MinWidth="120"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="柜子名称" Binding="{Binding DeviceName}" Width="*" MinWidth="120"
                                                ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                            <DataGridTextColumn Header="通讯 ID" Binding="{Binding DeviceId}" Width="*" MinWidth="120"
                                                ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                            <DataGridTextColumn Header="指纹/权限" Binding="{Binding FingerprintPermissionCountText}" Width="92"
                                                 ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTemplateColumn Header="同步状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataSyncText}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataSyncText}" Value="已同步">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AttentionKind}" Value="lagging">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataSyncText}" Value="离线">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="设备状态" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DeviceStateText}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MaintenanceActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="最后在线" Binding="{Binding LastSeenTime, StringFormat={}{0:MM-dd HH:mm}}" Width="100"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTemplateColumn Header="操作" Width="168">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Tag="{Binding}" Click="SyncOneButton_Click"
                                                    Style="{StaticResource IconButton}" Content="&#xE895;"
                                                    ToolTip="同步本柜指纹与权限（每用户一槽）" Width="30" MinWidth="30"
                                                    Height="30" MinHeight="30" Margin="0,0,4,0"/>
                                            <Button Tag="{Binding}" Click="EditDeviceButton_Click"
                                                    Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                    ToolTip="修改柜子名称和编号" Width="30" MinWidth="30"
                                                    Height="30" MinHeight="30" Margin="0,0,4,0"/>
                                            <Button Tag="{Binding}" Click="OpenDetailButton_Click"
                                                    Style="{StaticResource IconButton}" Content="&#xE76C;"
                                                    ToolTip="打开柜子详情" Width="30" MinWidth="30"
                                                    Height="30" MinHeight="30" Margin="0,0,4,0"/>
                                            <Button Tag="{Binding}" Click="DeleteDeviceButton_Click"
                                                    Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    ToolTip="删除柜子" Width="30" MinWidth="30"
                                                    Height="30" MinHeight="30"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="&#xE968;" FontFamily="{StaticResource AppIconFont}" FontSize="28"
                                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateText" Text="暂无柜子" Margin="0,8,0,0"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="OperationProgressPanel" Grid.Row="3" Margin="0,10,0,0"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="OperationProgressText" Grid.Row="0"
                       Foreground="{StaticResource SubTextBrush}" Margin="2,0,0,6"/>
            <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Height="6"
                         Minimum="0" Maximum="100" IsIndeterminate="True"/>
        </Grid>

    </Grid>
</Page>
