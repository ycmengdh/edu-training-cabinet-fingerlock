<local:BorderlessWindow x:Class="CabinetLock.ContinuousEnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="连续录入指纹" Width="720" Height="610"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinWidth="640" MinHeight="520" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="连续录入" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageStatusText}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,16,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="采集柜机" Style="{StaticResource LabelText}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox x:Name="DeviceCombo" Grid.Column="1" DisplayMemberPath="DisplayText"
                          SelectedValuePath="DeviceId" MinWidth="280"/>
                <TextBlock x:Name="ProgressText" Grid.Column="2" Margin="18,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="QueueGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="顺序" Binding="{Binding Sequence}" Width="64"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="1.3*"/>
                    <DataGridTextColumn Header="学号" Binding="{Binding StudentNo}" Width="1.3*"/>
                    <DataGridTextColumn Header="已有指纹" Binding="{Binding ExistingCountText}" Width="100"/>
                    <DataGridTextColumn Header="本次状态" Binding="{Binding StatusText}" Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="跳过当前" Style="{StaticResource SecondaryButton}"
                        Click="SkipButton_Click"/>
                <Button Content="关闭" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click"/>
                <Button x:Name="EnrollNextButton" Content="录入下一位" Margin="8,0,0,0"
                        Click="EnrollNextButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:BorderlessWindow>
