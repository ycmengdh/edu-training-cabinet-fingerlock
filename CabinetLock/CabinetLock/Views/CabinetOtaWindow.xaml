<local:BorderlessWindow x:Class="CabinetLock.CabinetOtaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="柜机固件发布" Height="760" Width="1180"
        MinHeight="680" MinWidth="960" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <local:BorderlessWindow.Resources>
        <Style x:Key="SummaryValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SummaryLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </local:BorderlessWindow.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="230"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="柜机 OTA 控制台" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="ConnectionText" Text="正在读取根节点与柜机状态"
                           Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <Button x:Name="ChooseFileButton" Grid.Column="1" Content="选择固件"
                    VerticalAlignment="Bottom" Click="ChooseFileButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,10" Padding="16,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="0.75*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="固件文件" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock x:Name="FileNameText" Grid.Column="1" Text="未选择"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="目标版本" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock x:Name="VersionText" Grid.Column="3" Text="--"/>
                <TextBlock Grid.Column="4" Text="镜像大小" Foreground="{StaticResource SubTextBrush}"/>
                <TextBlock x:Name="ImageSizeText" Grid.Column="5" Text="--"/>

                <TextBlock Grid.Row="1" Text="SHA-256" Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,0"/>
                <TextBlock x:Name="ShaText" Grid.Row="1" Grid.Column="1" Text="--"
                           FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,10,18,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="兼容硬件" Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,0"/>
                <TextBlock x:Name="HardwareVersionText" Grid.Row="1" Grid.Column="3" Text="--" Margin="0,10,0,0"/>
                <CheckBox x:Name="RestrictHardwareCheckBox" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                          Content="仅升级同硬件版本" Margin="0,8,0,0"
                          Checked="HardwareRestriction_Changed" Unchecked="HardwareRestriction_Changed"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="16,13" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StageText" Text="尚未发布" FontWeight="SemiBold"/>
                <TextBlock x:Name="NodeCountText" Grid.Column="1" Text="0 / 0 台完成"
                           Foreground="{StaticResource SubTextBrush}"/>
                <ProgressBar x:Name="OtaProgressBar" Grid.Row="1" Grid.ColumnSpan="2"
                             Height="8" Minimum="0" Maximum="100" Margin="0,10,0,0"/>
                <TextBlock x:Name="ProgressDetailText" Grid.Row="2" Grid.ColumnSpan="2"
                           Text="--" Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,10">
            <Grid Height="68">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CompletedCountText" Text="0" Style="{StaticResource SummaryValueText}"
                               Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="已完成" Style="{StaticResource SummaryLabelText}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,13"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ActiveCountText" Text="0" Style="{StaticResource SummaryValueText}"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="升级中" Style="{StaticResource SummaryLabelText}"/>
                </StackPanel>
                <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="0,13"/>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock x:Name="WaitingCountText" Text="0" Style="{StaticResource SummaryValueText}"
                               Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="等待中" Style="{StaticResource SummaryLabelText}"/>
                </StackPanel>
                <Border Grid.Column="5" Background="{StaticResource BorderBrush}" Margin="0,13"/>
                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock x:Name="FailedCountText" Text="0" Style="{StaticResource SummaryValueText}"
                               Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="失败重试" Style="{StaticResource SummaryLabelText}"/>
                </StackPanel>
                <Border Grid.Column="7" Background="{StaticResource BorderBrush}" Margin="0,13"/>
                <StackPanel Grid.Column="8" VerticalAlignment="Center">
                    <TextBlock x:Name="OfflineCountText" Text="0" Style="{StaticResource SummaryValueText}"
                               Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock Text="离线" Style="{StaticResource SummaryLabelText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="4" x:Name="DetailTabs">
            <TabItem Header="设备进度">
                <Border Style="{StaticResource Panel}" Padding="0">
                    <DataGrid x:Name="NodeDataGrid" BorderThickness="0" IsReadOnly="True"
                              SelectionMode="Single" EnableRowVirtualization="True">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PhaseKind}" Value="offline">
                                        <Setter Property="Opacity" Value="0.68"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="145"
                                                ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                            <DataGridTextColumn Header="层级" Binding="{Binding LayerText}" Width="58"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="升级来源" Binding="{Binding ParentText}" Width="145"
                                                ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                            <DataGridTextColumn Header="当前版本" Binding="{Binding VersionText}" Width="108"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTemplateColumn Header="状态" Width="102">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource SubTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PhaseKind}" Value="complete">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PhaseKind}" Value="active">
                                                                <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PhaseKind}" Value="waiting">
                                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PhaseKind}" Value="failed">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PhaseKind}" Value="offline">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="进度" Width="148">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="126">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Height="7" Minimum="0" Maximum="100"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                                       FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="重试" Binding="{Binding RetryText}" Width="58"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="最近上报" Binding="{Binding UpdatedText}" Width="88"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTemplateColumn Header="详情" Width="*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorText}" ToolTip="{Binding ErrorToolTip}"
                                                   Style="{StaticResource DataGridLeftTextBlockStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="操作日志">
                <Border Style="{StaticResource Panel}" Padding="14,12">
                    <TextBox x:Name="LogTextBox" Style="{x:Null}"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                             IsReadOnly="True" BorderThickness="0" Padding="2,0,6,2"
                             Background="Transparent" FontFamily="{StaticResource MonoFont}"
                             Foreground="{StaticResource TextBrush}" FontSize="11"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AutoRefreshCheckBox" Content="自动刷新" IsChecked="True"/>
                <TextBlock x:Name="LastRefreshText" Text="尚未刷新"
                           Foreground="{StaticResource SubTextBrush}" Margin="12,1,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="QueryStatusButton" Content="立即刷新" Style="{StaticResource SecondaryButton}"
                        Click="QueryStatusButton_Click"/>
                <Button x:Name="CancelButton" Content="取消发布" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="CancelButton_Click"/>
                <Button x:Name="StartButton" Content="发布为目标版本" Margin="8,0,0,0"
                        IsEnabled="False" Click="StartButton_Click"/>
                <Button x:Name="CloseButton" Content="关闭" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:BorderlessWindow>
