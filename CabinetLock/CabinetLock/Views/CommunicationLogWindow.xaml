<local:BorderlessWindow x:Class="CabinetLock.CommunicationLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="通讯日志" Height="700" Width="1000" MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 状态点 + 计数 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="通讯日志" Style="{StaticResource TitleText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Ellipse x:Name="LinkStatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LinkStatusText" Text="链路未连接" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TransportText" Text="链路类型: --" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource ConsoleHeaderBrush}" CornerRadius="7" Padding="14,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TX " Foreground="{StaticResource ConsoleMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="SentCountText" Text="0" Foreground="{StaticResource ConsoleTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                    <TextBlock Text="   RX " Foreground="{StaticResource ConsoleMutedBrush}" FontSize="11"/>
                    <TextBlock x:Name="ReceivedCountText" Text="0" Foreground="{StaticResource ConsoleTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                    <TextBlock Text="   自动滚动" Foreground="{StaticResource ConsoleMutedBrush}" FontSize="11" Margin="20,0,0,0"/>
                    <CheckBox x:Name="AutoScrollCheck" IsChecked="True" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 过滤工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,16,0,12" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="方向过滤：" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                <CheckBox x:Name="ShowSendCheck" Content="发送" IsChecked="True" Margin="6,0,0,0" VerticalAlignment="Center" Click="FilterCheck_Changed"/>
                <CheckBox x:Name="ShowRecvCheck" Content="接收" IsChecked="True" Margin="6,0,0,0" VerticalAlignment="Center" Click="FilterCheck_Changed"/>
                <CheckBox x:Name="ShowSystemCheck" Content="状态" IsChecked="True" Margin="6,0,0,0" VerticalAlignment="Center" Click="FilterCheck_Changed"/>
                <TextBlock Text="类别过滤：" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="20,0,0,0"/>
                <ComboBox x:Name="CategoryFilterBox" Width="160" SelectionChanged="CategoryFilterBox_SelectionChanged">
                    <ComboBoxItem Content="全部" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="协议 JSON" Tag="协议 JSON"/>
                    <ComboBoxItem Content="协议 BIN" Tag="协议 BIN"/>
                    <ComboBoxItem Content="ACK/ERROR" Tag="ACK"/>
                    <ComboBoxItem Content="设备状态" Tag="设备"/>
                    <ComboBoxItem Content="链路" Tag="链路"/>
                    <ComboBoxItem Content="发送失败" Tag="发送失败"/>
                    <ComboBoxItem Content="解析失败" Tag="解析失败"/>
                </ComboBox>
                <TextBlock Text="关键字：" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="20,0,0,0"/>
                <TextBox x:Name="KeywordBox" Width="180" VerticalAlignment="Center" TextChanged="KeywordBox_TextChanged"/>
                <Button Content="清空日志" Style="{StaticResource SecondaryButton}" Margin="20,0,0,0" Click="ClearButton_Click"/>
                <Button Content="导出" Margin="6,0,0,0" Click="ExportButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 日志列表 -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
            <DataGrid x:Name="LogGrid" BorderThickness="0" Background="Transparent"
                      RowHeaderWidth="0" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="None" HeadersVisibility="Column"
                      AlternatingRowBackground="{StaticResource GridAlternateBrush}" RowBackground="{StaticResource CardBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="100" FontFamily="{StaticResource MonoFont}"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="60"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="100"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="内容" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Padding="2,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Left"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部详情（选中行展开原始字节 / hex 等） -->
        <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="12,8" MinHeight="80">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="原始内容（完整可复制）：" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="DetailTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="NoWrap"
                             AcceptsReturn="True" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</local:BorderlessWindow>
