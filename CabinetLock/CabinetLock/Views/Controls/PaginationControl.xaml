<UserControl x:Class="CabinetLock.Controls.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="34">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TotalText" Text="共 0 条" Style="{StaticResource PagerInfoText}" Margin="0,0,14,0"/>
            <TextBlock Text="每页" Style="{StaticResource PagerInfoText}" Margin="0,0,6,0"/>
            <ComboBox x:Name="PageSizeBox" Width="68" Height="30"
                      SelectionChanged="PageSizeBox_SelectionChanged"/>
            <TextBlock Text="条" Style="{StaticResource PagerInfoText}" Margin="6,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="FirstButton" Style="{StaticResource CompactSecondaryButton}" Content="&#xE892;"
                    FontFamily="{StaticResource AppIconFont}" Width="32" MinWidth="32" Padding="0"
                    ToolTip="首页" Click="FirstButton_Click"/>
            <Button x:Name="PreviousButton" Style="{StaticResource CompactSecondaryButton}" Content="&#xE76B;"
                    FontFamily="{StaticResource AppIconFont}" Width="32" MinWidth="32" Padding="0" Margin="6,0,0,0"
                    ToolTip="上一页" Click="PreviousButton_Click"/>
            <StackPanel x:Name="PageNumberPanel" Orientation="Horizontal" Margin="6,0,0,0"/>
            <Button x:Name="NextButton" Style="{StaticResource CompactSecondaryButton}" Content="&#xE76C;"
                    FontFamily="{StaticResource AppIconFont}" Width="32" MinWidth="32" Padding="0" Margin="6,0,0,0"
                    ToolTip="下一页" Click="NextButton_Click"/>
            <Button x:Name="LastButton" Style="{StaticResource CompactSecondaryButton}" Content="&#xE893;"
                    FontFamily="{StaticResource AppIconFont}" Width="32" MinWidth="32" Padding="0" Margin="6,0,0,0"
                    ToolTip="末页" Click="LastButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock x:Name="PageInfoText" Text="第 1 / 1 页" Style="{StaticResource PagerInfoText}" Margin="0,0,10,0"/>
            <TextBlock Text="跳至" Style="{StaticResource PagerInfoText}" Margin="0,0,6,0"/>
            <TextBox x:Name="JumpPageBox" Width="48" Height="30" TextAlignment="Center"
                     VerticalContentAlignment="Center" KeyDown="JumpPageBox_KeyDown"/>
            <TextBlock Text="页" Style="{StaticResource PagerInfoText}" Margin="6,0,6,0"/>
            <Button Style="{StaticResource CompactSecondaryButton}" Content="跳转" Width="54" MinWidth="54"
                    Click="JumpButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
