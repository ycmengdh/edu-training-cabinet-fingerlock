<local:BorderlessWindow x:Class="CabinetLock.FingerprintTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="指纹测试" Width="640" Height="650" MinWidth="560" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="指纹测试" Style="{StaticResource TitleText}"/>
            <TextBlock Text="测试模板只写入柜机临时槽 ID=0，不参与权限判断或开锁。"
                       Style="{StaticResource PageStatusText}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="18,16" Margin="0,18,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="角色" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="RoleCombo" Grid.Row="1" DisplayMemberPath="DisplayText" SelectedValuePath="Role"
                          SelectionChanged="RoleCombo_SelectionChanged"/>
                <TextBlock Grid.Column="2" Text="班级" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="ClassCombo" Grid.Row="1" Grid.Column="2" DisplayMemberPath="DisplayText" SelectedValuePath="ClassId"
                          SelectionChanged="ClassCombo_SelectionChanged"/>
                <TextBlock Grid.Row="2" Text="用户" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                <ComboBox x:Name="UserCombo" Grid.Row="3" DisplayMemberPath="DisplayText" SelectedValuePath="UserId"
                          SelectionChanged="UserCombo_SelectionChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="指纹" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                <ComboBox x:Name="FingerprintCombo" Grid.Row="3" Grid.Column="2" DisplayMemberPath="DisplayText"
                          SelectedValuePath="FingerprintId" SelectionChanged="SelectionChanged"/>
                <TextBlock Grid.Row="4" Text="目标柜机" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                <ComboBox x:Name="DeviceCombo" Grid.Row="5" Grid.ColumnSpan="3" DisplayMemberPath="DisplayText"
                          SelectedValuePath="DeviceId" SelectionChanged="SelectionChanged"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Border Style="{StaticResource Panel}" Padding="18,16" MinHeight="210">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TestStateText" Text="待开始" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TestTargetText" Text="请选择测试目标" Style="{StaticResource PageStatusText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock x:Name="CountdownText" Text="60" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="秒后退出" Style="{StaticResource LabelText}"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="6"
                        Padding="18" Margin="0,14,0,14">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="EventSequenceText" Text="00" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock x:Name="EventIconText" Text="&#xE928;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="48" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,8"/>
                        <TextBlock x:Name="EventText" Text="等待测试" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EventDetailText" Style="{StaticResource PageStatusText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MatchedCountText" Text="匹配 0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NotMatchedCountText" Grid.Column="1" Text="不匹配 0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorCountText" Grid.Column="2" Text="异常 0" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>
          </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Content="关闭" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
            <Button x:Name="StopButton" Content="结束测试" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Click="StopButton_Click" IsEnabled="False"/>
            <Button x:Name="StartButton" Content="开始测试" Margin="8,0,0,0" Click="StartButton_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
