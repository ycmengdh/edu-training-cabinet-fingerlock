<Page x:Class="CabinetLock.ClassManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CabinetLock.Controls"
      Title="班级管理" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="班级管理" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <ScrollViewer Grid.Column="1" Style="{StaticResource ToolbarScroll}" VerticalAlignment="Bottom" MaxWidth="700">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="220" Margin="0,0,8,0">
                        <TextBox x:Name="ClassSearchBox" Padding="34,4,10,4"
                                 ToolTip="按班级名称、班级 ID 或教师搜索"
                                 TextChanged="ClassSearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource AppIconFont}"
                                   Foreground="{StaticResource SubTextBrush}" Margin="11,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="AddButton" Content="添加班级" Foreground="White" Click="AddButton_Click"/>
                    <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="删除"
                            Margin="8,0,0,0" IsEnabled="False" Click="DeleteButton_Click"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0" Click="RefreshButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <DataGrid x:Name="ClassDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Extended"
                      MouseDoubleClick="ClassDataGrid_MouseDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox ToolTip="选择本页全部班级" Checked="SelectPageCheckBox_Changed"
                                          Unchecked="SelectPageCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          Checked="ClassSelectionCheckBox_Changed"
                                          Unchecked="ClassSelectionCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="班级 ID" Binding="{Binding ClassId}" Width="160"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="班级名称" Binding="{Binding Name}" Width="190"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="教师" Binding="{Binding TeacherText}" Width="1.2*"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="教师数" Binding="{Binding TeacherCount}" Width="76"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="学生数" Binding="{Binding StudentCount}" Width="86"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="86"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="150"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="操作" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="&#xE70F;" FontFamily="{StaticResource AppIconFont}" Tag="{Binding}"
                                            Style="{StaticResource IconButton}" ToolTip="编辑班级信息"
                                            Width="32" MinWidth="32" Height="30" MinHeight="30" Margin="0,0,6,0"
                                            Click="EditRowButton_Click"/>
                                    <Button Content="&#xE77B;" FontFamily="{StaticResource AppIconFont}" Tag="{Binding}"
                                            Style="{StaticResource IconButton}" ToolTip="管理班级学生"
                                            Width="32" MinWidth="32" Height="30" MinHeight="30"
                                            Click="ManageRowButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <controls:PaginationControl x:Name="Pager" Grid.Row="2" Margin="0,10,0,0"
                                    PageRequested="Pager_PageRequested"/>
    </Grid>
</Page>
