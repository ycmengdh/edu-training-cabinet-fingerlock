<local:BorderlessWindow x:Class="CabinetLock.ImportUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="导入用户 CSV" Height="420" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="导入用户 CSV" Style="{StaticResource TitleText}"/>
            <TextBlock Text="列顺序：user_code, name, role, password, class_id, device_number（后两列可选）。学生的 user_code 填学号，首行表头可自动跳过。"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,5,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,16,0,12" Padding="16">
            <StackPanel>
                <TextBlock Text="文件" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilePathBox" IsReadOnly="True" Height="34"/>
                    <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Width="88" Height="34"
                            Style="{StaticResource SecondaryButton}" Click="BrowseButton_Click"/>
                </Grid>
                <TextBlock x:Name="HintText"
                           Text="学生密码可为空；device_number 填现场设备编号，导入后自动绑定对应柜机。"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,14,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ResultText" Margin="0,14,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Foreground="{StaticResource SubTextBrush}" FontSize="11"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click"/>
            <Button x:Name="ImportButton" Content="开始导入" Margin="8,0,0,0" Click="ImportButton_Click"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
