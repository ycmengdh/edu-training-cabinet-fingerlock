<local:BorderlessWindow x:Class="CabinetLock.ExitBusinessSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="退出前同步业务数据"
        Width="600" Height="520" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,22,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="7" Background="{StaticResource PrimaryLightBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="&#xE898;" FontFamily="{StaticResource AppIconFont}" FontSize="17"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="正在保存本次业务数据" Style="{StaticResource TitleText}" FontSize="19"/>
                <TextBlock Text="应用将在 SD 确认接收后退出" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,18">
            <StackPanel>
                <Border Style="{StaticResource ToolbarPanel}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusTitleText" Text="准备上传" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock x:Name="AttemptText" Grid.Column="1" Text="第 1/3 次"
                                       Foreground="{StaticResource SubTextBrush}"/>
                        </Grid>
                        <ProgressBar x:Name="UploadProgress" Grid.Row="1" Height="7" Minimum="0" Maximum="100"
                                     IsIndeterminate="True" Margin="0,0,0,12"/>
                        <TextBlock x:Name="StatusDetailText" Grid.Row="2" Text="正在检查根节点 SD 状态"
                                   Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                                   TextTrimming="None" MinHeight="38"/>
                    </Grid>
                </Border>

                <Border x:Name="FailurePanel" Background="{StaticResource DangerSurfaceBrush}"
                        BorderThickness="0" CornerRadius="7"
                        Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="业务数据尚未上传到 SD" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="可重新上传；如仍需强制退出，系统会打开并选中 business.db，请先将该文件复制到安全目录。"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                   TextTrimming="None" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="LastErrorText" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" TextTrimming="None"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}"
                Background="{StaticResource BackgroundBrush}" Padding="24,16,24,20">
            <Grid>
                <Button x:Name="RetryButton"
                        Content="重新上传" HorizontalAlignment="Left" Visibility="Collapsed"
                        Click="RetryButton_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelExitButton" Style="{StaticResource SecondaryButton}"
                            Content="取消退出" Click="CancelExitButton_Click"/>
                    <Button x:Name="ForceExitButton" Style="{StaticResource DangerButton}"
                            Content="不上传，强制退出" Margin="8,0,0,0" Visibility="Collapsed"
                            Click="ForceExitButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:BorderlessWindow>
