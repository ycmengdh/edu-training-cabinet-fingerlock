<local:BorderlessWindow x:Class="CabinetLock.SyncQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="柜机待同步队列"
        Icon="pack://application:,,,/Resources/logo.ico"
        Width="820" Height="520" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="柜机待同步" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="StatusText" Text="用户可有多枚指纹模板；权限按用户与指纹 ID 逐条同步。"
                           Style="{StaticResource PageStatusText}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}"
                        Content="刷新" Margin="0,0,8,0" Click="RefreshButton_Click"/>
                <Button x:Name="RetryButton" Content="立即重试" Click="RetryButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <DataGrid x:Name="JobGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="72"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="64"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="账号/学号" Binding="{Binding UserCode}" Width="110"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="柜子" Binding="{Binding DeviceId}" Width="140"
                                        ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="1.2*"
                                        ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                    <DataGridTextColumn Header="次数" Binding="{Binding AttemptCount}" Width="48"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="错误" Binding="{Binding LastError}" Width="1.4*"
                                        ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                    <DataGridTextColumn Header="更新" Binding="{Binding UpdateTime, StringFormat=MM-dd HH:mm:ss}" Width="100"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="关闭" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
