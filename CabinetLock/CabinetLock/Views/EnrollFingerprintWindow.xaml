<local:BorderlessWindow x:Class="CabinetLock.EnrollFingerprintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="指纹录入" Height="720" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="指纹录入" Style="{StaticResource TitleText}"/>
            <TextBlock Text="选择未录入的手指将新增指纹；选择已录入的手指将覆盖原指纹，并同步已绑定柜机。"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,14">
            <StackPanel>
                <Border Style="{StaticResource Panel}" Padding="18,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="角色" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="RoleCombo" Grid.Row="1" DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Role" SelectionChanged="RoleCombo_SelectionChanged"/>
                        <TextBlock Grid.Column="2" Text="班级" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ClassCombo" Grid.Row="1" Grid.Column="2" DisplayMemberPath="DisplayText"
                                  SelectedValuePath="ClassId" SelectionChanged="ClassCombo_SelectionChanged"/>
                        <TextBlock Grid.Row="2" Text="姓名" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                        <ComboBox x:Name="UserCombo" Grid.Row="3" DisplayMemberPath="DisplayText"
                                  SelectedValuePath="UserId" SelectionChanged="SelectionChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="目标柜机" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                        <ComboBox x:Name="DeviceCombo" Grid.Row="3" Grid.Column="2" DisplayMemberPath="DisplayText"
                                  SelectedValuePath="DeviceId" SelectionChanged="SelectionChanged"/>
                        <TextBlock Grid.Row="4" Text="录入手指与保存方式" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                        <ComboBox x:Name="FingerCombo" Grid.Row="5" Grid.ColumnSpan="3" DisplayMemberPath="DisplayText"
                                  SelectedValuePath="FingerIndex" SelectionChanged="SelectionChanged"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel}" Padding="18,16">
                    <StackPanel>
                        <ProgressBar x:Name="EnrollProgress" Height="22" Minimum="0" Maximum="7" Value="0"/>
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="6" Padding="16,18" Margin="0,14,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="StepIcon" Text="&#xE928;" FontFamily="{StaticResource AppIconFont}"
                                           FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock x:Name="StepHint" Text="选择用户和柜机后开始录入"
                                           FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"/>
                                <TextBlock x:Name="StepDetail" FontSize="11" HorizontalAlignment="Center"
                                           Margin="0,6,0,0" Foreground="{StaticResource SubTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ResultText" FontSize="12" Margin="0,14,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestButton" Content="测试本次指纹" Style="{StaticResource SecondaryButton}"
                    Click="TestButton_Click" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Content="关闭" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Click="CancelButton_Click"/>
            <Button x:Name="EnrollButton" Content="开始录入" Margin="8,0,0,0"
                    Click="EnrollButton_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
