<Page x:Class="CabinetLock.TeacherManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CabinetLock.Controls"
      Title="教师管理" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="教师管理" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="管理教师账号及负责班级" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="FingerprintSyncButton" Style="{StaticResource SecondaryButton}"
                        Content="教师指纹同步" Margin="0,0,8,0" Click="FingerprintSyncButton_Click"/>
                <Button x:Name="EnrollTeacherFingerprintButton" Style="{StaticResource SecondaryButton}"
                        Content="录入教师指纹" Margin="0,0,8,0" Click="EnrollTeacherFingerprintButton_Click"/>
                <Button x:Name="AddTeacherButton" Content="添加教师" Click="AddTeacherButton_Click"/>
                <Button x:Name="EditTeacherButton" Style="{StaticResource SecondaryButton}" Content="编辑" Margin="8,0,0,0" Click="EditTeacherButton_Click"/>
                <Button x:Name="ResetPasswordButton" Style="{StaticResource SecondaryButton}" Content="重置密码" Margin="8,0,0,0" Click="ResetPasswordButton_Click"/>
                <Button x:Name="ToggleTeacherButton" Style="{StaticResource SecondaryButton}" Content="启用 / 停用" Margin="8,0,0,0" Click="ToggleTeacherButton_Click"/>
                <Button x:Name="DeleteTeacherButton" Style="{StaticResource DangerButton}" Content="删除" Margin="8,0,0,0" Click="DeleteTeacherButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新教师" Margin="8,0,0,0" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <DataGrid x:Name="TeacherDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="教师 ID" Binding="{Binding DisplayId}" Width="180"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="160"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="负责班级" Binding="{Binding ResponsibleClassText}" Width="2.2*"
                                        ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                    <DataGridTextColumn Header="班级数" Binding="{Binding ResponsibleClassCount}" Width="76"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="指纹 ID" Binding="{Binding FingerprintId}" Width="100"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="180"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="操作" Width="124">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="&#xE70F;" FontFamily="{StaticResource AppIconFont}" Tag="{Binding}"
                                            Style="{StaticResource IconButton}" ToolTip="编辑教师及负责班级"
                                            Width="32" MinWidth="32" Height="30" MinHeight="30" Margin="0,0,6,0"
                                            Click="EditRowButton_Click"/>
                                    <Button Content="&#xE72E;" FontFamily="{StaticResource AppIconFont}" Tag="{Binding}"
                                            Style="{StaticResource IconButton}" ToolTip="重置教师密码"
                                            Width="32" MinWidth="32" Height="30" MinHeight="30" Margin="0,0,6,0"
                                            Click="ResetPasswordRowButton_Click"/>
                                    <Button Content="&#xE74D;" FontFamily="{StaticResource AppIconFont}" Tag="{Binding}"
                                            Style="{StaticResource IconButton}" ToolTip="删除教师"
                                            Width="32" MinWidth="32" Height="30" MinHeight="30"
                                            Click="DeleteRowButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <controls:PaginationControl x:Name="Pager" Grid.Row="2" Margin="0,10,0,0"
                                    PageRequested="Pager_PageRequested"/>
    </Grid>
</Page>
