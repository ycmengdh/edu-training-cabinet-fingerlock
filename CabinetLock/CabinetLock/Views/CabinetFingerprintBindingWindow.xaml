<local:BorderlessWindow x:Class="CabinetLock.CabinetFingerprintBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="绑定用户指纹" Width="660" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="绑定用户指纹" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="CabinetMetaText" Text="选择用户模板并下发到当前柜机"
                       Style="{StaticResource PageStatusText}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,16,0,12" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="用户" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="UserCombo" Height="38" DisplayMemberPath="DisplayText"
                              SelectedValuePath="UserId" IsTextSearchEnabled="True"
                              TextSearch.TextPath="DisplayText"
                              SelectionChanged="UserCombo_SelectionChanged"/>
                </StackPanel>
                <Button x:Name="EnrollButton" Grid.Column="2" Content="录入新指纹"
                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"
                        Height="38" Click="EnrollButton_Click" IsEnabled="False"
                        ToolTip="使用当前柜机 0 号临时槽采集，完成后不自动绑定"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Panel}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="用户指纹模板" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock x:Name="TemplateStatusText" Text="请先选择用户"
                                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TemplateCountText" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                    </Grid>
                    <ListBox x:Name="TemplateList" Grid.Row="1" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="5,7" Checked="TemplateSelection_Changed"
                                          Unchecked="TemplateSelection_Changed">
                                    <Grid Width="520">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FingerprintId, StringFormat=模板 #{0}}"
                                                   FontFamily="{StaticResource MonoFont}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FingerName}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BackupStatusText}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource SubTextBrush}"/>
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="NoTemplatePanel" Grid.Row="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="&#xE928;" FontFamily="{StaticResource AppIconFont}" FontSize="30"
                                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="该用户还没有可用指纹" Margin="0,8,0,0"
                                   Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock Text="请先点击“录入新指纹”，录入完成后再选择模板绑定"
                                   Margin="0,4,0,0" FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,12,0,0" Padding="16,13">
                <StackPanel>
                    <TextBlock Text="当前柜机开锁权限" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="4">
                        <CheckBox x:Name="Lock0CheckBox" Content="系统锁"/>
                        <CheckBox x:Name="Lock1CheckBox" Content="柜门 1"/>
                        <CheckBox x:Name="Lock2CheckBox" Content="柜门 2"/>
                        <CheckBox x:Name="Lock3CheckBox" Content="柜门 3"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                    Background="{StaticResource PrimaryLightBrush}">
                <Grid>
                    <ProgressBar x:Name="SyncProgress" Width="88" Height="5"
                                 HorizontalAlignment="Left" IsIndeterminate="True"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Text="绑定后才会把模板写入柜机正式槽位"
                               Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource PrimaryDarkBrush}" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="录入与绑定相互独立" VerticalAlignment="Center"
                       Foreground="{StaticResource SubTextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="关闭" Style="{StaticResource SecondaryButton}"
                        Click="CancelButton_Click"/>
                <Button x:Name="BindButton" Content="绑定并下发" Width="112" Margin="8,0,0,0"
                        Click="BindButton_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:BorderlessWindow>
