<local:BorderlessWindow x:Class="CabinetLock.StudentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="学生详情" Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,14" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StudentNameText" Text="学生" Style="{StaticResource TitleText}"/>
                    <TextBlock x:Name="StudentMetaText" Text="学号 · 班级" Style="{StaticResource PageStatusText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="5" Padding="12,7" Margin="0,0,10,0">
                        <TextBlock x:Name="StudentStatusText" Text="启用" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </Border>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            ToolTip="刷新学生详情" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" MinWidth="520"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*" MinWidth="430"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开锁授权（按实训柜）" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="添加授权后选择柜子，再配置指纹模板和柜门权限" Style="{StaticResource PageStatusText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="BindCabinetButton" Grid.Column="1" Content="添加授权" Margin="12,0,0,0"
                                Click="BindCabinetButton_Click"/>
                    </Grid>
                    <DataGrid x:Name="CabinetGrid" Grid.Row="1" BorderThickness="0" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="CabinetGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceNumber}" Width="82"
                                                 ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="柜子" Binding="{Binding DeviceName}" Width="100"
                                                 ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding OnlineText}" Width="58"
                                                 ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="柜门权限" Binding="{Binding LockPermissionText}" Width="112"
                                                ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                            <DataGridTextColumn Header="使用指纹" Binding="{Binding SelectedFingerprintText}" Width="1.2*"
                                                 ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                            <DataGridTextColumn Header="授权状态" Binding="{Binding SyncStatusText}" Width="78"
                                                 ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTemplateColumn Header="操作" Width="142">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="修改" Tag="{Binding}" Width="58" MinWidth="58"
                                                    Height="30" MinHeight="30" Margin="0,0,6,0"
                                                    Click="ConfigureCabinetButton_Click"/>
                                            <Button Content="解除" Tag="{Binding}" Width="58" MinWidth="58"
                                                    Height="30" MinHeight="30" Style="{StaticResource SecondaryButton}"
                                                    Click="UnbindCabinetButton_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*" MinHeight="210"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="1*" MinHeight="250"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="用户指纹" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="可录入多枚；每台柜机可下发一枚或多枚，默认使用第一枚" Style="{StaticResource PageStatusText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="EnrollFingerprintButton" Content="录入指纹" Height="36" Click="EnrollFingerprintButton_Click"/>
                                <Button x:Name="TestFingerprintButton" Content="测试" Style="{StaticResource SecondaryButton}"
                                        Height="36" Margin="8,0,0,0" Click="TestFingerprintButton_Click"/>
                                <Button x:Name="RestoreFingerprintButton" Content="下发到柜子" Style="{StaticResource SecondaryButton}"
                                        Height="36" Margin="8,0,0,0" Click="RestoreFingerprintButton_Click"/>
                                <Button x:Name="DeleteFingerprintButton" Content="删除" Style="{StaticResource DangerButton}"
                                        Height="36" Margin="8,0,0,0" Click="DeleteFingerprintButton_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="FingerprintGrid" Grid.Row="1" BorderThickness="0" IsReadOnly="True"
                                  SelectionMode="Single" SelectionChanged="FingerprintGrid_SelectionChanged">
                            <DataGrid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="手指" Binding="{Binding FingerName}" Width="1.0*"
                                                    ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding FingerprintId}" Width="58"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="质量" Binding="{Binding QualityText}" Width="62"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="来源柜子" Binding="{Binding SourceDevice}" Width="1.1*"
                                                    ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                                <DataGridTextColumn Header="备份状态" Binding="{Binding BackupStatusText}" Width="100"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="使用柜机" Binding="{Binding UsedCabinetCountText}" Width="82"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="默认柜门权限" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="批量分配和旧数据使用此默认值；单柜配置可独立覆盖" Style="{StaticResource PageStatusText}" Margin="0,3,0,10"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="48"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="Lock1CheckBox" Grid.Row="0" Content="柜门 1" VerticalAlignment="Center"/>
                            <CheckBox x:Name="Lock2CheckBox" Grid.Row="1" Content="柜门 2" VerticalAlignment="Center"/>
                            <CheckBox x:Name="Lock3CheckBox" Grid.Row="2" Content="柜门 3" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="VerifySyncButton" Content="校验并同步" Style="{StaticResource SecondaryButton}"
                                    Click="VerifySyncButton_Click"/>
                            <Button x:Name="ResetPermissionsButton" Content="按模板重置" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="ResetPermissionsButton_Click"/>
                            <Button x:Name="SavePermissionsButton" Content="保存并同步" Margin="8,0,0,0"
                                    Click="SavePermissionsButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="" Style="{StaticResource PageStatusText}"
                   Margin="2,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</local:BorderlessWindow>
