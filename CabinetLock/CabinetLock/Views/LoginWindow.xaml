<local:BorderlessWindow x:Class="CabinetLock.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="登录 - 实训柜权限管理系统"
        Icon="pack://application:,,,/Resources/logo.ico"
        Height="500" Width="800" MinHeight="500" MinWidth="780"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="LoginTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="38,4,12,4" />
            <Setter Property="SelectionBrush" Value="{StaticResource InputSelectionBrush}" />
            <Setter Property="SelectionTextBrush" Value="{StaticResource InputSelectionTextBrush}" />
            <Setter Property="SelectionOpacity" Value="1" />
        </Style>
        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="38,4,12,4" />
            <Setter Property="SelectionBrush" Value="{StaticResource InputSelectionBrush}" />
            <Setter Property="SelectionTextBrush" Value="{StaticResource InputSelectionTextBrush}" />
            <Setter Property="SelectionOpacity" Value="1" />
        </Style>
        <Style x:Key="LoginActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="LoginPasswordToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="IconBackground" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBackground" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧品牌区 -->
        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="34,32,30,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="10" Background="{StaticResource SidebarBrandBrush}">
                        <Image Source="pack://application:,,,/Resources/logo-rounded.png"
                               Width="36" Height="36" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               SnapsToDevicePixels="True" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="实训柜权限管理系统" Foreground="{StaticResource SidebarTextBrush}" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="实训柜权限管理" Foreground="{StaticResource SidebarTextBrush}" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock Text="欢迎使用" Foreground="{StaticResource SidebarTextBrush}" FontSize="16" Margin="0,8,0,0" />
                    <Border Width="42" Height="3" Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left" Margin="0,22,0,0" />
                    <TextBlock Text="业务数据已就绪，请输入账号登录" Foreground="{StaticResource SidebarMutedBrush}" FontSize="11"
                               Margin="0,20,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource SidebarHoverBrush}" CornerRadius="8" Padding="13,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="LinkStatusDot" Width="9" Height="9" Fill="{StaticResource DangerBrush}"
                                 VerticalAlignment="Top" Margin="0,4,0,0" />
                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                            <TextBlock x:Name="LinkStatusText" Text="等待根节点" Foreground="{StaticResource SidebarTextBrush}" FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="LinkStatusDetailText" Text="物理链路尚未连接" Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧登录表单 -->
        <Grid Grid.Column="1" Margin="56,40,56,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="系统登录" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="请输入已授权的用户 ID 和密码" Foreground="{StaticResource SubTextBrush}"
                           FontSize="11" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="账号 ID" Style="{StaticResource LabelText}" Margin="0,0,0,8" FontSize="12" />
                <Grid>
                    <TextBox x:Name="UserIdBox" Style="{StaticResource LoginTextBox}"
                             SelectionOpacity="0.55" Text="admin" />
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource AppIconFont}" FontSize="15"
                               Foreground="{StaticResource SubTextBrush}" Margin="14,0,0,0" HorizontalAlignment="Left"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>

                <TextBlock Text="密码" Style="{StaticResource LabelText}" Margin="0,16,0,8" FontSize="12" />
                    <Grid>
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource LoginPasswordBox}"
                                     SelectionOpacity="0.55" />
                        <TextBox x:Name="PasswordTextBox" Style="{StaticResource LoginTextBox}"
                                 Visibility="Collapsed" Padding="38,4,48,4" MaxLength="128"
                                 SelectionOpacity="0.55" />
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource SubTextBrush}" Margin="14,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <ToggleButton x:Name="PasswordVisibilityToggle" 
                                      Content="&#xE890;"
                                      Style="{StaticResource LoginPasswordToggle}"
                                      ToolTip="显示密码"
                                      IsChecked="False"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" 
                                      Margin="0,0,12,0" 
                                      Click="TogglePasswordVisibility" />
                    </Grid>



                <Button x:Name="LoginButton" Style="{StaticResource LoginActionButton}" Margin="0,22,0,0" Click="LoginButton_Click">
                    <TextBlock Text="登录" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <CheckBox x:Name="RememberPasswordCheckBox" 
                          Content="记住密码" 
                          Margin="0,12,0,0" 
                          VerticalAlignment="Center" />
            </StackPanel>

            <Border x:Name="HintBorder" Grid.Row="2" Background="{StaticResource HintBrush}"
                    BorderThickness="0" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource AppIconFont}" FontSize="13"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Top" Margin="0,1,9,0" />
                    <TextBlock x:Name="HintText" Grid.Column="1" Text="请输入账号信息"
                               Foreground="{StaticResource SubTextBrush}" FontSize="11" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:BorderlessWindow>
