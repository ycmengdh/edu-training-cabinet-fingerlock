<Page x:Class="CabinetLock.ClassStudentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CabinetLock.Controls"
      Title="班级管理" Background="{StaticResource BackgroundBrush}">
    <Page.Resources>
        <Style x:Key="ClassWorkspaceTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="2"
                                      Margin="2,0,0,-1"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,8,8,8" Padding="1">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClassWorkspaceTabItem" TargetType="TabItem">
            <Setter Property="MinWidth" Value="106"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="SelectionBar" Height="3" CornerRadius="2"
                                        Background="{StaticResource PrimaryBrush}"
                                        VerticalAlignment="Top" Visibility="Collapsed"/>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource PageHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource IconButton}"
                    Content="&#xE72B;" ToolTip="返回班级管理" Margin="0,0,12,0"
                    Click="BackButton_Click"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="PageTitleText" Text="班级学生" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="正在读取学生" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ImportStudentsButton" Content="导入学生"
                        Style="{StaticResource SecondaryButton}" Click="ImportStudentsButton_Click"/>
                <Button x:Name="AddStudentButton" Content="新增学生" Margin="8,0,0,0"
                        Click="AddStudentButton_Click"/>
                <Button x:Name="BatchEnrollButton" Content="连续录指纹" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="BatchEnrollButton_Click"/>
                <Button x:Name="CabinetSyncButton" Content="批量分配柜机" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}" Click="CabinetSyncButton_Click"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        ToolTip="刷新班级工作台" Margin="8,0,0,0" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,13" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="0.65*"/>
                    <ColumnDefinition Width="0.65*"/>
                    <ColumnDefinition Width="0.65*"/>
                    <ColumnDefinition Width="0.65*"/>
                    <ColumnDefinition Width="0.65*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ClassNameText" Text="班级" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock x:Name="ClassIdText" Text="班级 ID" Style="{StaticResource PageStatusText}"/>
                    <TextBlock x:Name="TeacherText" Text="教师：未分配" Style="{StaticResource PageStatusText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock x:Name="StudentCountText" Text="0" Style="{StaticResource MetricValueText}"/>
                    <TextBlock Text="学生" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="FingerprintCountText" Text="0" Style="{StaticResource MetricValueText}"/>
                    <TextBlock Text="已录指纹" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock x:Name="AssignedCountText" Text="0" Style="{StaticResource MetricValueText}"/>
                    <TextBlock Text="已分配" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="ReadyCountText" Text="0" Style="{StaticResource MetricValueText}"/>
                    <TextBlock Text="可使用" Style="{StaticResource LabelText}"/>
                </StackPanel>
                <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                    <TextBlock x:Name="PendingCountText" Text="0" Style="{StaticResource MetricValueText}"
                               Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="待处理" Style="{StaticResource LabelText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" x:Name="WorkspaceTabs" Style="{StaticResource ClassWorkspaceTabControl}">
            <TabItem Header="学生名单" Style="{StaticResource ClassWorkspaceTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="StudentDataGrid" BorderThickness="0" IsReadOnly="True"
                              SelectionMode="Extended" MouseDoubleClick="StudentDataGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="1.0*"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="学号" Binding="{Binding StudentNo}" Width="1.05*"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="性别" Binding="{Binding GenderText}" Width="66"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="使用状态" Binding="{Binding WorkflowStatus}" Width="105"
                                                    ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                <DataGridTextColumn Header="用户指纹" Binding="{Binding FingerprintText}" Width="1.25*"
                                                    ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                                <DataGridTextColumn Header="分配柜机" Binding="{Binding CabinetText}" Width="1.4*"
                                                    ElementStyle="{StaticResource DataGridLeftTextBlockStyle}"/>
                                <DataGridTemplateColumn Header="操作" Width="204">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button Content="编辑" Tag="{Binding}" Style="{StaticResource SecondaryButton}"
                                                        Width="58" MinWidth="58" Height="30" MinHeight="30" Margin="0,0,6,0"
                                                        Click="EditStudentButton_Click"/>
                                                <Button Content="管理" Tag="{Binding}" Width="58" MinWidth="58"
                                                        Height="30" MinHeight="30" Margin="0,0,6,0"
                                                        ToolTip="管理柜机权限与使用指纹"
                                                        Click="ManageStudentButton_Click"/>
                                                <Button Content="删除" Tag="{Binding}" Style="{StaticResource DangerButton}"
                                                        Width="58" MinWidth="58" Height="30" MinHeight="30"
                                                        Click="DeleteStudentButton_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:PaginationControl x:Name="StudentPager" Grid.Row="1" Margin="10,7,10,9"
                                                PageRequested="StudentPager_PageRequested"/>
                </Grid>
            </TabItem>

            <TabItem Header="实训柜列表" Style="{StaticResource ClassWorkspaceTabItem}">
                <DataGrid x:Name="CabinetOverviewGrid" BorderThickness="0" IsReadOnly="True">
                    <DataGrid.Columns>
                            <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceNumber}" Width="110"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="柜机名称" Binding="{Binding DeviceName}" Width="140"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="链路" Binding="{Binding OnlineText}" Width="72"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTemplateColumn Header="分配状态" Width="2.2*" MinWidth="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource SubTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding AvailabilityText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridLeftTextBlockStyle}">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="可使用" Binding="{Binding ReadyCount}" Width="76"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="待处理" Binding="{Binding PendingCount}" Width="76"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTemplateColumn Header="操作" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="分配学生" Tag="{Binding}" Width="96"
                                                Height="30" MinHeight="30" VerticalAlignment="Center"
                                                Click="OpenCabinetAssignmentButton_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
