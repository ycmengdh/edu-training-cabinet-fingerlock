<Page x:Class="CabinetLock.PermissionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CabinetLock.Controls"
      Title="个人权限" Background="{StaticResource BackgroundBrush}">
    <Page.Resources>
        <Style x:Key="PermissionGridLeftTextBlockStyle" TargetType="TextBlock"
               BasedOn="{StaticResource DataGridLeftTextBlockStyle}">
            <Setter Property="Margin" Value="10,0,6,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="个人权限" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButton}"
                    Content="&#xE72C;" ToolTip="刷新权限" Click="RefreshButton_Click" VerticalAlignment="Bottom"/>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
            <Grid MinWidth="1072">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MinWidth="560"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="4*" MinWidth="500"/>
                </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Padding="14,0">
                        <TextBlock Text="用户列表" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                    </Border>
                    <Grid Grid.Row="1" Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ClassFilterCombo" Height="32"
                                  SelectedIndex="0" SelectionChanged="ClassFilterCombo_SelectionChanged"/>
                        <TextBox x:Name="UserSearchBox" Grid.Column="2" Height="32"
                                 ToolTip="搜索姓名 / 学号或工号 / 班级" TextChanged="UserSearchBox_TextChanged"/>
                    </Grid>
                    <DataGrid x:Name="UserListBox" Grid.Row="2" BorderThickness="0" IsReadOnly="True"
                              CanUserResizeColumns="False" CanUserReorderColumns="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="UserListBox_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="0.85*" MinWidth="90"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="账号 / 学号" Binding="{Binding IdentityText}" Width="1.2*" MinWidth="130"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="0.65*" MinWidth="72"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                            <DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="1.4*" MinWidth="130"
                                                ElementStyle="{StaticResource PermissionGridLeftTextBlockStyle}"/>
                            <DataGridTextColumn Header="权限更新" Binding="{Binding PermissionUpdateText}" Width="1.15*" MinWidth="150"
                                                ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="PermissionEditor" Grid.Column="2" Style="{StaticResource Panel}" IsEnabled="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <Border Padding="18,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedUserName" Text="未选择用户" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectedUserFp" Text="指纹模板：-" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border x:Name="RoleBadge" Grid.Column="1"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedUserRole" Text="-" FontSize="11"
                                           Foreground="{StaticResource SubTextBrush}"
                                           VerticalAlignment="Center" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="StandardPermissionPanel" Grid.Row="1" Margin="18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="锁权限" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Column="1" Text="来源" Style="{StaticResource LabelText}" HorizontalAlignment="Right"/>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10,0">
                            <Grid><CheckBox x:Name="Lock0CheckBox" Content="Lock 1   系统锁" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lock0Source" Text="角色默认" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}"/></Grid>
                        </Border>
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="10,0">
                            <Grid><CheckBox x:Name="Lock1CheckBox" Content="Lock 2   实训柜 1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lock1Source" Text="角色默认" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}"/></Grid>
                        </Border>
                        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10,0">
                            <Grid><CheckBox x:Name="Lock2CheckBox" Content="Lock 3   实训柜 2" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lock2Source" Text="角色默认" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}"/></Grid>
                        </Border>
                        <Border Grid.Row="4" Grid.ColumnSpan="2" Padding="10,0">
                            <Grid><CheckBox x:Name="Lock3CheckBox" Content="Lock 4   实训柜 3" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Lock3Source" Text="角色默认" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SubTextBrush}"/></Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="StudentAuthorizationPanel" Grid.Row="1" Margin="18,10,18,14"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="开锁授权（按实训柜）" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="每台实训柜独立选择指纹模板和柜门权限"
                                       Style="{StaticResource PageStatusText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="StudentAuthorizationGrid" BorderThickness="0" IsReadOnly="True"
                                      SelectionMode="Single">
                                <DataGrid.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="实训柜" Binding="{Binding DeviceText}" Width="110"
                                                        ElementStyle="{StaticResource PermissionGridLeftTextBlockStyle}"/>
                                    <DataGridTextColumn Header="指纹模板" Binding="{Binding FingerprintText}" Width="1.25*" MinWidth="150"
                                                        ElementStyle="{StaticResource PermissionGridLeftTextBlockStyle}"/>
                                    <DataGridTextColumn Header="柜门权限" Binding="{Binding LockPermissionText}" Width="1*" MinWidth="120"
                                                        ElementStyle="{StaticResource PermissionGridLeftTextBlockStyle}"/>
                                    <DataGridTextColumn Header="授权状态" Binding="{Binding AuthorizationStatusText}" Width="76"
                                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="StudentAuthorizationEmpty" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="未绑定实训柜，当前不能开锁" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="请通过下方按钮添加柜机授权"
                                           Foreground="{StaticResource SubTextBrush}" FontSize="11"
                                           Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="StandardPermissionActions" Grid.Row="2" Padding="14,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ManageFingerprintButton" Content="管理指纹" Style="{StaticResource SecondaryButton}"
                                    Click="ManageFingerprintButton_Click"/>
                            <Button x:Name="ResetButton" Content="按模板重置" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Click="ResetButton_Click"/>
                            <Button x:Name="SaveButton" Content="保存权限" Margin="8,0,0,0" Click="SaveButton_Click" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="StudentAuthorizationActions" Grid.Row="2" Padding="14,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ManageStudentFingerprintButton" Content="管理指纹"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ManageFingerprintButton_Click"/>
                            <Button x:Name="ManageStudentAuthorizationButton" Content="管理柜机授权"
                                    Margin="8,0,0,0"
                                    Click="ManageStudentAuthorizationButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>

        <controls:PaginationControl x:Name="Pager" Grid.Row="2" Margin="0,10,0,0"
                                    PageRequested="Pager_PageRequested"/>
    </Grid>
</Page>
