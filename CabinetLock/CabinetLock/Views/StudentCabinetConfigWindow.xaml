<local:BorderlessWindow x:Class="CabinetLock.StudentCabinetConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="配置柜机权限" Width="520" Height="570"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="CabinetNameText" Text="实训柜" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="CabinetMetaText" Text="设备编号 · 在线状态"
                       Style="{StaticResource PageStatusText}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,16,0,14" Padding="14,12">
            <StackPanel>
                <TextBlock Text="柜门权限" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                <UniformGrid Columns="3">
                    <CheckBox x:Name="Lock1CheckBox" Content="柜门 1"/>
                    <CheckBox x:Name="Lock2CheckBox" Content="柜门 2"/>
                    <CheckBox x:Name="Lock3CheckBox" Content="柜门 3"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="使用指纹" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock x:Name="FingerprintCountText" HorizontalAlignment="Right"
                               Foreground="{StaticResource SubTextBrush}"/>
                </Grid>
                <ListBox x:Name="FingerprintList" Grid.Row="1" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="5,7">
                                <Grid Width="390">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FingerName}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FingerprintId, StringFormat=# {0}}"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding BackupStatusText}"
                                               HorizontalAlignment="Right" Foreground="{StaticResource SubTextBrush}"/>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="选择会独立应用到当前实训柜" VerticalAlignment="Center"
                       Foreground="{StaticResource SubTextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
                <Button Content="保存并同步" Width="108" Margin="8,0,0,0" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</local:BorderlessWindow>
