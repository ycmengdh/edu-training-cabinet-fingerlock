<Page x:Class="CabinetLock.UserManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CabinetLock.Controls"
      Title="用户管理" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageTitleText" Text="用户管理" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="等待根节点数据" Style="{StaticResource PageStatusText}"/>
            </StackPanel>
            <ScrollViewer Grid.Column="1" Style="{StaticResource ToolbarScroll}" VerticalAlignment="Bottom" MaxWidth="680">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="AddUserButton" Click="AddUserButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource AppIconFont}" Foreground="{StaticResource PrimaryForegroundBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="添加用户" Foreground="{StaticResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ImportUsersButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="导入用户" ToolTip="通过 Excel 批量导入用户" Click="ImportUsersButton_Click"/>
                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,6,2,6"/>
                <Button x:Name="BatchAssignPermButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="批量分配权限" ToolTip="为已勾选用户分配柜子锁权限并同步"
                        IsEnabled="False" Click="BatchAssignPermButton_Click"/>
                <Button x:Name="DeleteUserButton" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                        IsEnabled="False" ToolTip="删除已勾选用户" Click="DeleteUserButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="删除所选" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新用户"
                        Margin="8,0,0,0" Click="RefreshButton_Click"/>
              </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="RoleFilterPanel" Orientation="Horizontal">
                    <TextBlock Text="角色" Style="{StaticResource LabelText}" Margin="0,0,10,0"/>
                    <ComboBox x:Name="RoleFilterBox" Width="140" SelectionChanged="RoleFilterBox_SelectionChanged">
                        <ComboBoxItem Content="全部角色" Tag=""/>
                        <ComboBoxItem Content="管理员" Tag="admin"/>
                        <ComboBoxItem Content="教师" Tag="teacher"/>
                        <ComboBoxItem Content="学生" Tag="student"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="搜索" Style="{StaticResource LabelText}" Margin="16,0,8,0"/>
                <TextBox x:Name="UserSearchBox" Width="200" Height="34"
                         ToolTip="姓名 / 学号或账号 ID / 班级" TextChanged="UserSearchBox_TextChanged"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid x:Name="UserDataGrid" BorderThickness="0" IsReadOnly="True" SelectionMode="Extended"
                      EnableRowVirtualization="True">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridTextBlockStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox ToolTip="选择本页全部用户" Checked="SelectPageCheckBox_Changed"
                                          Unchecked="SelectPageCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          Checked="UserSelectionCheckBox_Changed"
                                          Unchecked="UserSelectionCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="账号 / 学号" Binding="{Binding DisplayId}" Width="170"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="140"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="90"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="班级" Binding="{Binding ClassId}" Width="110"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="72"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="指纹 ID" Binding="{Binding FingerprintId}" Width="100"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="*"
                                        ElementStyle="{StaticResource DataGridTextBlockStyle}"/>
                    <DataGridTemplateColumn Header="操作" Width="118">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="&#xE70F;" FontFamily="{StaticResource AppIconFont}" Tag="{Binding}"
                                            Style="{StaticResource IconButton}" ToolTip="编辑用户"
                                            Width="32" MinWidth="32" Height="30" MinHeight="30" Margin="0,0,6,0"
                                            Click="EditRowButton_Click"/>
                                    <Button Content="&#xE928;" FontFamily="{StaticResource AppIconFont}" Tag="{Binding}"
                                            Style="{StaticResource IconButton}" ToolTip="录入用户指纹"
                                            Width="32" MinWidth="32" Height="30" MinHeight="30" Margin="0,0,6,0"
                                            Click="AssignFingerprintRowButton_Click"/>
                                    <Button Content="&#xE712;" FontFamily="{StaticResource AppIconFont}" Tag="{Binding}"
                                            Style="{StaticResource IconButton}" ToolTip="更多操作"
                                            Width="32" MinWidth="32" Height="30" MinHeight="30"
                                            Click="MoreRowButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <controls:PaginationControl x:Name="Pager" Grid.Row="3" Margin="0,10,0,0"
                                    PageRequested="Pager_PageRequested"/>
    </Grid>
</Page>
