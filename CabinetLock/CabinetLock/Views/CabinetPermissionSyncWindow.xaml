<local:BorderlessWindow x:Class="CabinetLock.CabinetPermissionSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="柜机指纹与权限同步" Width="1120" Height="700" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="柜机指纹与权限同步" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="PageStatusText" Text="正在读取柜机状态"
                           Style="{StaticResource PageStatusText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Style="{StaticResource IconButton}"
                    Content="&#xE72C;" ToolTip="重新读取柜机状态" VerticalAlignment="Bottom"
                    Click="RefreshButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Margin="0,16,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CabinetCountText" Text="柜机 0" Margin="0,0,18,0"/>
                    <TextBlock x:Name="OnlineCountText" Text="在线 0" Margin="0,0,18,0"/>
                    <TextBlock x:Name="SuccessCountText" Text="成功 0"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,0,18,0"/>
                    <TextBlock x:Name="FailedCountText" Text="未完成 0"
                               Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RetryFailedButton" Content="重试未完成柜机"
                            Style="{StaticResource SecondaryButton}" Click="RetryFailedButton_Click"/>
                    <Button x:Name="SyncAllButton" Content="增量同步全部在线柜机"
                            Margin="8,0,0,0" Click="SyncAllButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid x:Name="CabinetGrid" BorderThickness="0" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceNumber}" Width="110"/>
                    <DataGridTextColumn Header="柜机名称" Binding="{Binding DeviceName}" Width="150"/>
                    <DataGridTextColumn Header="CAB MAC" Binding="{Binding MeshMac}" Width="145"/>
                    <DataGridTextColumn Header="在线" Binding="{Binding OnlineText}" Width="68"/>
                    <DataGridTextColumn Header="权限版本" Binding="{Binding VersionText}" Width="155"/>
                    <DataGridTextColumn Header="指纹/权限" Binding="{Binding CountText}" Width="100"/>
                    <DataGridTemplateColumn Header="进度" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="6,0">
                                    <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"/>
                                    <TextBlock Text="{Binding ProgressText, Mode=OneWay}" FontSize="11"
                                               Foreground="{StaticResource SubTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="88"/>
                    <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="1.4*" MinWidth="180"/>
                    <DataGridTemplateColumn Header="操作" Width="78">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="同步" Tag="{Binding}" IsEnabled="{Binding CanSync}"
                                        Click="SyncOneButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <ProgressBar x:Name="SyncProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="ProgressText" Style="{StaticResource PageStatusText}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="CloseButton" Content="关闭"
                    Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                    VerticalAlignment="Bottom" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</local:BorderlessWindow>
