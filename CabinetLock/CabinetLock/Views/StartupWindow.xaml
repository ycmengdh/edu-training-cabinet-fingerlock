<local:BorderlessWindow x:Class="CabinetLock.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="启动 - 实训柜权限管理系统"
        Icon="pack://application:,,,/Resources/logo.ico"
        Width="540" Height="620" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="StartupPortBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="StartupRefreshButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource AppIconFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="LinkModeSegment" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent" CornerRadius="6" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主卡片：铺满内容区，避免贴左/底部大块空白 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="28,24"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌头 -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource HintBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
                            <Image Source="pack://application:,,,/Resources/logo-rounded.png"
                                   Stretch="Uniform" SnapsToDevicePixels="True" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="实训柜权限管理系统" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="连接设备并同步业务数据" Foreground="{StaticResource SubTextBrush}"
                                       FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Width="36" Height="3" Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" />
                </StackPanel>

                <!-- 串口选择 -->
                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="通讯链路" Style="{StaticResource LabelText}" Margin="0,0,0,8" FontSize="12" />
                    <Border Background="{StaticResource HintBrush}" CornerRadius="7" Padding="3" Margin="0,0,0,14">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="MeshModeButton" GroupName="LinkMode" Content="组网U盘连接"
                                         Style="{StaticResource LinkModeSegment}" Checked="LinkMode_Checked" />
                            <RadioButton x:Name="UartModeButton" GroupName="LinkMode" Content="柜机串口直连"
                                         Style="{StaticResource LinkModeSegment}" Checked="LinkMode_Checked" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="选择串口" Style="{StaticResource LabelText}" Margin="0,0,0,8" FontSize="12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SerialPortBox" IsEditable="True"
                                  Style="{StaticResource StartupPortBox}" />
                        <Button x:Name="RefreshPortsButton" Grid.Column="1" Style="{StaticResource StartupRefreshButton}"
                                Content="&#xE72C;" Margin="10,0,0,0"
                                Click="RefreshPortsButton_Click" ToolTip="刷新串口列表" />
                    </Grid>
                </StackPanel>

                <!-- 链路状态 + 分步进度 -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                            Margin="0,16,0,0">
                    <Border Background="{StaticResource HintBrush}" BorderThickness="0"
                            CornerRadius="8" Padding="14,11" MinHeight="64"
                            HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource DangerBrush}"
                                     VerticalAlignment="Top" Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch">
                                <TextBlock x:Name="StatusText" Text="等待连接" FontSize="12"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="StatusDetail" Text="正在尝试连接设备…"
                                           Foreground="{StaticResource SubTextBrush}"
                                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 分步指示：1连接 2就绪 3备份 4同步 5完成 -->
                    <UniformGrid x:Name="StepStrip" Columns="5" Margin="0,14,0,0">
                        <TextBlock x:Name="Step1Text" Text="1 连接" FontSize="10" TextAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock x:Name="Step2Text" Text="2 就绪" FontSize="10" TextAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock x:Name="Step3Text" Text="3 备份" FontSize="10" TextAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock x:Name="Step4Text" Text="4 同步" FontSize="10" TextAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock x:Name="Step5Text" Text="5 完成" FontSize="10" TextAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </UniformGrid>

                    <TextBlock x:Name="ProgressText" Text="正在准备…" Foreground="{StaticResource SubTextBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,10,0,8" MinHeight="28" />
                    <ProgressBar x:Name="SyncProgress" Height="5" IsIndeterminate="False"
                                 Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="LastPortHintText" Text=""
                               Foreground="{StaticResource SubTextBrush}" FontSize="10"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部操作区：默认仅显示「退出」；同步失败后才显示「重试 / 仅本地继续」 -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <StackPanel x:Name="FailurePanel" Visibility="Collapsed" Margin="0,0,0,10">
                <Border Background="{StaticResource HintBrush}" BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="设备同步未完成" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="FailureHintText"
                                   Text="可重试连接；若设备暂不可用，可用本机历史业务库进入（只读/受限，不代表 SD 最新）。"
                                   Foreground="{StaticResource SubTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Button x:Name="RetryButton" Content="重新连接并同步" Height="38"
                        Click="RetryButton_Click" IsEnabled="False" />
                <Button x:Name="UseLocalButton" Style="{StaticResource SecondaryButton}"
                        Content="仅用本机数据进入登录" Height="38" Margin="0,8,0,0"
                        ToolTip="使用最近备份或本机 business.db，不拉取 SD。适合设备离线应急。"
                        Click="UseLocalButton_Click" IsEnabled="False" />
            </StackPanel>
            <Button x:Name="ExitButton" Style="{StaticResource GhostButton}"
                    Content="退出程序" HorizontalAlignment="Center"
                    Click="ExitButton_Click" />
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
