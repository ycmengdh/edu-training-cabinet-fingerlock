<local:BorderlessWindow x:Class="CabinetLock.ClassLifecycleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="班级数据处理" Width="720" Height="500" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="班级数据处理" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="StatusText" Text="正在准备" Style="{StaticResource PageStatusText}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,12">
            <ProgressBar x:Name="OperationProgress" Height="8" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="ProgressText" Text="等待开始" Margin="0,8,0,0"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14">
            <ListBox x:Name="DetailList" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RetryButton" Content="重试失败项" Visibility="Collapsed"
                    Click="RetryButton_Click"/>
            <Button x:Name="CloseButton" Content="关闭" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
