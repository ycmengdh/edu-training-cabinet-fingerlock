<local:BorderlessWindow x:Class="CabinetLock.BackupFingerprintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="设备专属副指纹录入" Height="520" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="设备专属副指纹录入" Style="{StaticResource TitleText}"/>
            <TextBlock Text="副指纹仅在本机生效，用于解决部分设备识别不灵敏的问题；不影响其他设备的主指纹"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,18,0,14" Padding="18,16">
            <StackPanel>
                <TextBlock Text="目标柜子" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ComboBox x:Name="DeviceCombo" DisplayMemberPath="DisplayText" SelectedValuePath="DeviceId"/>

                <TextBlock Text="目标用户" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                <ComboBox x:Name="UserCombo" DisplayMemberPath="DisplayText" SelectedValuePath="UserId"/>

                <TextBlock Text="录入进度" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                <ProgressBar x:Name="EnrollProgress" Height="18" Minimum="0" Maximum="6" Value="0"/>
                <TextBlock x:Name="ProgressHint" Text="点击下方按钮开始录入"
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>

                <TextBlock x:Name="ResultText" Text="" FontSize="11" Margin="0,10,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
            <Button x:Name="EnrollButton" Content="开始录入副指纹" Margin="8,0,0,0" Click="EnrollButton_Click"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
