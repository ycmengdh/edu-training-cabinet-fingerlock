<local:BorderlessWindow x:Class="CabinetLock.BatchAssignPermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="批量分配柜子权限" Height="620" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="批量分配柜子权限" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="SummaryText"
                       Text="为所选用户写入锁权限并绑定柜子；默认同步第一枚，也可在学生详情按柜多选"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,5,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标柜子（勾选）" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="SelectAllButton" Style="{StaticResource CompactSecondaryButton}"
                                    Content="优先选空闲" Height="28" Padding="10,0" Click="SelectAllButton_Click"/>
                            <Button x:Name="ClearSelectButton" Style="{StaticResource CompactSecondaryButton}"
                                    Content="清空" Height="28" Padding="10,0" Margin="6,0,0,0" Click="ClearSelectButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="CabinetSearchBox" DockPanel.Dock="Top" Height="34" Margin="0,0,0,8"
                             ToolTip="按编号、名称或 ID 过滤" TextChanged="CabinetSearchBox_TextChanged"/>
                    <ListBox x:Name="CabinetList" SelectionMode="Extended" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Content="{Binding DisplayText}"
                                          Margin="4,6,4,6"
                                          FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14">
                <StackPanel>
                    <TextBlock Text="锁权限" Style="{StaticResource LabelText}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="Lock0Check" Content="Lock 1  系统锁" Margin="0,0,0,10"/>
                    <CheckBox x:Name="Lock1Check" Content="Lock 2  实训柜 1" IsChecked="True" Margin="0,0,0,10"/>
                    <CheckBox x:Name="Lock2Check" Content="Lock 3  实训柜 2" IsChecked="True" Margin="0,0,0,10"/>
                    <CheckBox x:Name="Lock3Check" Content="Lock 4  实训柜 3" Margin="0,0,0,4"/>
                    <TextBlock Text="系统锁仅管理员可勾选。绑定后每柜只为该用户占用 1 个指纹槽。"
                               Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,14,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectionCountText" Text="已选 0 台柜子"
                               Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Foreground="{StaticResource SubTextBrush}" FontSize="11"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
            <Button x:Name="ApplyButton" Content="保存并同步" Margin="8,0,0,0" Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</local:BorderlessWindow>
