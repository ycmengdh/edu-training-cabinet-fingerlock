<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 输出类型与目标框架 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 高 DPI 下无边框窗口尺寸/边框对齐更稳定 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- 单文件独立编译配置：发布后单 exe，无需安装 .NET 运行时 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- 程序集信息 -->
    <AssemblyName>CabinetLock</AssemblyName>
    <Product>实训柜权限管理系统</Product>
    <Company>学校实训中心</Company>
    <Version>1.0.0</Version>
    <RootNamespace>CabinetLock</RootNamespace>
    <!-- 排除本项目历次独立编译产生的 .check/.verify 等临时目录，避免生成代码被二次编译。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.*\**</DefaultItemExcludes>
    <!-- 可执行文件 / 任务栏图标 -->
    <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON 序列化 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- USB 串口通讯（与 Mesh 根节点 USB 双链路） -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- 本机业务库 / 日志库 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- XLSX 导入、模板与结果导出 -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF 资源：窗口 Icon / 关于页 / 侧栏品牌图（pack URI） -->
    <Resource Include="Resources\logo.ico" />
    <!-- 圆角透明 PNG，用于界面 Image 展示（比 ICO 透明边更干净） -->
    <Resource Include="Resources\logo-rounded.png" />
  </ItemGroup>
  <!-- 同步一份到输出目录，供 Win32 任务栏图标 LoadImage 使用 -->
  <Target Name="CopyLogoIcoToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_LogoOutDir>$([System.IO.Path]::Combine('$(OutputPath)', 'Resources'))</_LogoOutDir>
    </PropertyGroup>
    <MakeDir Directories="$(_LogoOutDir)" />
    <Copy SourceFiles="Resources\logo.ico"
          DestinationFiles="$(_LogoOutDir)\logo.ico"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
