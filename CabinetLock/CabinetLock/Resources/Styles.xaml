<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CabinetLock"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="AppIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{Binding [PrimaryBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{Binding [PrimaryDarkBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{Binding [PrimaryLightBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{Binding [PrimaryHoverBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{Binding [PrimaryForegroundBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{Binding [AccentBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{Binding [BackgroundBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{Binding [CardBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="InputBrush" Color="{Binding [InputBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="InputSelectionBrush" Color="{Binding [InputSelectionBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="InputSelectionTextBrush" Color="{Binding [InputSelectionTextBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{Binding [TextBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="{Binding [SubTextBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{Binding [BorderBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{Binding [SurfaceAltBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{Binding [SurfaceHoverBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{Binding [SurfacePressedBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="ReadOnlyBrush" Color="{Binding [ReadOnlyBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{Binding [DangerBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{Binding [DangerSurfaceBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{Binding [DangerPressedBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{Binding [DangerBorderBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{Binding [SuccessBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{Binding [WarningBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="GridHeaderBrush" Color="{Binding [GridHeaderBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="GridHeaderTextBrush" Color="{Binding [GridHeaderTextBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="GridAlternateBrush" Color="{Binding [GridAlternateBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="{Binding [GridLineBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="{Binding [RowHoverBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="{Binding [StatusBarBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="HintBrush" Color="{Binding [HintBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="HintBorderBrush" Color="{Binding [HintBorderBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{Binding [SidebarBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{Binding [SidebarHoverBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{Binding [SidebarActiveBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="{Binding [SidebarBorderBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{Binding [SidebarTextBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{Binding [SidebarMutedBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarIconBrush" Color="{Binding [SidebarIconBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarIconHoverBrush" Color="{Binding [SidebarIconHoverBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarIconPressedBrush" Color="{Binding [SidebarIconPressedBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarAvatarBrush" Color="{Binding [SidebarAvatarBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="SidebarBrandBrush" Color="{Binding [SidebarBrandBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="ConsoleBrush" Color="{Binding [ConsoleBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="ConsoleAltBrush" Color="{Binding [ConsoleAltBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="ConsoleHeaderBrush" Color="{Binding [ConsoleHeaderBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="{Binding [ConsoleTextBrush], Source={x:Static local:ThemeManager.Colors}}"/>
    <SolidColorBrush x:Key="ConsoleMutedBrush" Color="{Binding [ConsoleMutedBrush], Source={x:Static local:ThemeManager.Colors}}"/>

    <DropShadowEffect x:Key="CardShadow"
                      Color="{Binding [ShadowColor], Source={x:Static local:ThemeManager.Colors}}"
                      Opacity="0.12"
                      BlurRadius="16" ShadowDepth="2" Direction="270"/>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="WindowCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="MinWidth" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource AppIconFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CaptionButtonSurface" Background="{TemplateBinding Background}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource AppIconFont}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="None"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaptionButtonSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CaptionButtonSurface" Property="Background" Value="{StaticResource SurfacePressedBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Close"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CaptionButtonSurface" Property="Background" Value="{StaticResource DangerBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource CardBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:BorderlessWindow}" BasedOn="{StaticResource {x:Type Window}}">
        <Setter Property="WindowStyle" Value="None"/>
        <!-- 边框由模板自绘，避免与 WindowChrome 非客户区边框叠两层 -->
        <Setter Property="BorderThickness" Value="0"/>
        <!-- 外框与侧边栏同色，浅色主题下比淡灰 BorderBrush 更清晰 -->
        <Setter Property="BorderBrush" Value="{StaticResource SidebarBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="40"
                                    ResizeBorderThickness="6"
                                    GlassFrameThickness="0"
                                    CornerRadius="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BorderlessWindow}">
                    <!-- 内容必须强制 Stretch：Window.HorizontalContentAlignment 默认是 Left，
                         若绑到 ContentPresenter.HorizontalAlignment 会导致内容贴左、右侧大片空白 -->
                    <Border x:Name="WindowSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource SidebarBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Width="22" Height="22" CornerRadius="6"
                                            Background="{StaticResource PrimaryLightBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/Resources/logo-rounded.png"
                                               Width="18" Height="18" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{TemplateBinding Title}"
                                               Foreground="{StaticResource TextBrush}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Button x:Name="PART_MinimizeButton"
                                                Style="{StaticResource WindowCaptionButton}"
                                                Content="&#xE921;" ToolTip="最小化"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                        <Button x:Name="PART_MaximizeButton"
                                                Style="{StaticResource WindowCaptionButton}"
                                                Content="&#xE922;" ToolTip="最大化"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                        <Button x:Name="PART_CloseButton"
                                                Style="{StaticResource WindowCaptionButton}"
                                                Content="&#xE8BB;" ToolTip="关闭" Tag="Close"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="shell:WindowChrome.WindowChrome">
                                <Setter.Value>
                                    <shell:WindowChrome CaptionHeight="40"
                                                        ResizeBorderThickness="0"
                                                        GlassFrameThickness="0"
                                                        CornerRadius="0"
                                                        UseAeroCaptionButtons="False"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="shell:WindowChrome.WindowChrome">
                                <Setter.Value>
                                    <shell:WindowChrome CaptionHeight="40"
                                                        ResizeBorderThickness="0"
                                                        GlassFrameThickness="0"
                                                        CornerRadius="0"
                                                        UseAeroCaptionButtons="False"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_MaximizeButton" Property="Content" Value="&#xE923;"/>
                            <Setter TargetName="PART_MaximizeButton" Property="ToolTip" Value="还原"/>
                            <!-- 最大化时去掉自绘边框，避免贴边留缝 -->
                            <Setter TargetName="WindowSurface" Property="BorderThickness" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="WindowSurface" Property="Opacity" Value="0.96"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Page">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="AppIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppIconFont}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="78"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfacePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DangerPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource AppIconFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="None"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfacePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarIconButton" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SidebarIconBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppIconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="None"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SidebarIconHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SidebarIconPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavBorder" Background="{TemplateBinding Background}">
                        <Grid>
                            <Rectangle x:Name="Indicator" Width="3" HorizontalAlignment="Left"
                                       Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
