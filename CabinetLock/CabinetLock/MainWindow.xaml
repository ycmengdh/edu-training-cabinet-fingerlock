<local:BorderlessWindow x:Class="CabinetLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CabinetLock"
        Title="实训柜权限管理系统"
        Icon="pack://application:,,,/Resources/logo.ico"
        Height="760" Width="1240" MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="84"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource SidebarBrandBrush}"
                                    Cursor="Hand" ToolTip="关于本软件" MouseLeftButtonUp="BrandLogo_MouseLeftButtonUp">
                                <Image Source="pack://application:,,,/Resources/logo-rounded.png"
                                       Width="22" Height="22" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="实训柜权限管理系统"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel>
                        <TextBlock Text="管理" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" Margin="18,4,0,8"/>
                        <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="Active"
                                Click="NavDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource AppIconFont}" FontSize="15" Width="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="总览" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavClassManage" Style="{StaticResource NavButton}" Click="NavClassManage_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource AppIconFont}" FontSize="15" Width="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="班级管理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTeacherManage" Style="{StaticResource NavButton}"
                                Click="NavTeacherManage_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource AppIconFont}" FontSize="15" Width="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="教师管理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavUserManage" Style="{StaticResource NavButton}"
                                Click="NavUserManage_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource AppIconFont}" FontSize="15" Width="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="用户管理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavPermission" Style="{StaticResource NavButton}" Click="NavPermission_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource AppIconFont}" FontSize="15" Width="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="个人权限" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavRolePermission" Style="{StaticResource NavButton}" Click="NavRolePermission_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE83D;" FontFamily="{StaticResource AppIconFont}" FontSize="15" Width="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="角色权限" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="设备" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" Margin="18,18,0,8"/>
                        <Button x:Name="NavDevice" Style="{StaticResource NavButton}" Click="NavDevice_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" FontFamily="{StaticResource AppIconFont}" FontSize="15" Width="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="实训柜" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavFingerprintTemplate" Style="{StaticResource NavButton}" Click="NavFingerprintTemplate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE928;" FontFamily="{StaticResource AppIconFont}" FontSize="15" Width="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="指纹库" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSystemLog" Style="{StaticResource NavButton}" Click="NavSystemLog_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource AppIconFont}" FontSize="15" Width="30" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="系统日志" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                      </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="14,10,14,14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- 第一行：头像 + 用户名 / 角色 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{StaticResource SidebarAvatarBrush}">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource AppIconFont}"
                                               Foreground="{StaticResource SidebarTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock x:Name="CurrentUserName" Text="管理员"
                                               Foreground="{StaticResource SidebarTextBrush}"
                                               FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="CurrentUserRole" Text="admin"
                                               Foreground="{StaticResource SidebarMutedBrush}"
                                               FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <!-- 第二行：操作按钮 -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="AboutButton" Style="{StaticResource SidebarIconButton}"
                                        Content="&#xE946;" ToolTip="关于本软件" Click="AboutButton_Click"/>
                                <Button x:Name="ThemeToggleButton" Style="{StaticResource SidebarIconButton}"
                                        Content="&#xE708;" ToolTip="切换为深色模式" Margin="6,0,0,0"
                                        Click="ThemeToggleButton_Click"/>
                                <Button x:Name="ChangePasswordButton" Style="{StaticResource SidebarIconButton}"
                                        Content="&#xE72E;" ToolTip="修改密码" Margin="6,0,0,0"
                                        Click="ChangePasswordButton_Click"/>
                                <Button x:Name="LogoutButton" Style="{StaticResource SidebarIconButton}"
                                        Content="&#xE8AC;" ToolTip="退出登录" Margin="6,0,0,0"
                                        Click="LogoutButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="DirectModeBanner" Visibility="Collapsed"
                        Background="{StaticResource HintBrush}" BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="0,0,0,1" Padding="16,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource AppIconFont}"
                                   Foreground="{StaticResource WarningBrush}" FontSize="15"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <TextBlock Text="柜机串口直连 · 应急维护模式" FontWeight="SemiBold"
                                       FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="仅操作当前柜机；业务变更保存在本机，恢复组网后将先校验版本再同步到 SD"
                                       Foreground="{StaticResource SubTextBrush}" FontSize="11"
                                       Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden"
                       Background="{StaticResource BackgroundBrush}" JournalOwnership="OwnsJournal"/>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource StatusBarRoot}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="MeshStatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}"/>
                    <TextBlock x:Name="MeshStatusText" Text="链路未连接" Margin="7,0,0,0" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Ellipse x:Name="RootDataStatusDot" Width="8" Height="8" Fill="{StaticResource DangerBrush}"/>
                    <TextBlock x:Name="RootDataStatusText" Text="根节点数据不可用" Margin="7,0,0,0" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock x:Name="OnlineDeviceLabel" Text="在线柜子" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                    <TextBlock x:Name="OnlineDeviceCount" Text="0" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"/>
                </StackPanel>
                <Button x:Name="PendingSyncButton" Grid.Column="3" Style="{StaticResource CompactSecondaryButton}"
                        Margin="14,0,0,0" MinWidth="88" Padding="10,0" Height="24"
                        ToolTip="查看柜机多指纹待同步队列"
                        Click="PendingSyncButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PendingSyncDot" Width="7" Height="7" Fill="{StaticResource SubTextBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="PendingSyncText" Text="待同步 0" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TransportTypeText" Grid.Column="4" Text="USB 串口" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                    <Button x:Name="SyncToSdButton" Style="{StaticResource CompactSecondaryButton}"
                            Content="立即同步到 SD" MinWidth="110"
                            ToolTip="将本机业务库与指纹模板立即上传到根节点 SD 卡"
                            Click="SyncToSdButton_Click"/>
                    <TextBlock x:Name="SyncStatusText" Text="" Foreground="{StaticResource SubTextBrush}"
                               FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="240"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="CurrentTimeText" Grid.Column="6" Foreground="{StaticResource SubTextBrush}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</local:BorderlessWindow>
